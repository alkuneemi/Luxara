<?xml version="1.0"?>
<odoo>
    <record id="view_pos_preset_form_inherit_pos_restaurant" model="ir.ui.view">
        <field name="name">pos.preset.form</field>
        <field name="model">pos.preset</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_preset_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='resource']" position="after">
                <page string="Options" name="options">
                    <group>
                        <group name="restaurant" string="Restaurant">
                            <field name="use_guest" />
                        </group>
                        <group name="additional_fee" string="Additional Fee">
                            <field name="service_fee" widget="boolean_toggle"/>
                            <field name="service_fee_product_id" invisible="not service_fee" required="service_fee" />
                            <field name="service_fee_type" invisible="not service_fee" widget="radio" />
                            <field name="service_fee_based_on" invisible="not service_fee or service_fee_type != 'percentage'" />
                            <field name="service_fee_amount" invisible="not service_fee or service_fee_type != 'fixed'" />
                            <field name="service_fee_amount" invisible="not service_fee or service_fee_type != 'percentage'" widget="percentage" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
