<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="l10n_es_pos.pos_order_receipt_header" inherit_id="point_of_sale.pos_order_receipt_header">
            <div name="cashier_name" position="before">
                <div t-if="order.get('is_l10n_es_simplified_invoice')" class="w-100 text-center mt-2 mb-2">
                    <div>Simplified invoice</div>
                    <div class="simplified-invoice-number" t-out="extra_data['invoice_name']" />
                </div>

                <t t-set="street" t-value="company.get('street')"/>
                <t t-set="zip" t-value="company.get('zip')"/>
                <t t-set="city" t-value="company.get('city')"/>
                <t t-set="state_name" t-value="company.get('state_name')"/>
                <div t-if="street or city or state_name or zip" class="company_address d-flex flex-column align-items-center my-2">
                    <span t-if="street" t-esc="street"/>
                    <span t-if="city or state_name or zip">
                        <span t-if="city" t-esc="city"/>
                        <span t-if="city and state_name"> · </span>
                        <span t-if="state_name" t-esc="state_name"/>
                        <span t-if="(city or state_name) and zip"> · </span>
                        <span t-if="zip" t-esc="zip"/>
                    </span>
                </div>
            </div>
            <div name="partner_info" position="attributes">
                <attribute name="t-if" separator="and" add="(not config.get('is_spanish') or not config.get('simplified_partner_id'))"/>
            </div>
        </template>
    </data>
</odoo>
