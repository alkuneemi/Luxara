<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mail.VoiceRecorder">
        <div class="o-mail-VoiceRecorder">
            <div class="o-mail-VoiceRecorder-elapsed" t-att-class="{ 'text-danger': this.props.state.limitWarning }">
                <span class="d-flex text-truncate" t-out="this.props.state.elapsed"/>
            </div>
            <button class="btn btn-link o-mail-VoiceRecorder-cancel" t-on-click="this.props.state.cancelRecording" t-att-title="this.cancelTitle">
                <i class="fa fa-times"/>
            </button>
            <button class="btn btn-link o-mail-VoiceRecorder-confirm position-relative" t-on-click="this.props.state.onClick" t-att-title="this.title">
                <div class="o-mail-VoiceRecorder-visualizer">
                    <t t-foreach="this.props.state.volumes" t-as="vol" t-key="vol_index">
                        <!-- monitorAudio returns volume ~0.0 to ~1.0, so we boost it for visual impact -->
                        <div class="o-mail-VoiceRecorder-bar" t-attf-style="transform: scaleY(#{Math.max(0.2, vol * 2.0)});"/>
                    </t>
                </div>
            </button>
        </div>
    </t>

</templates>
