<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.WelcomePage.inviteHeader">
    <div class="d-flex flex-column text-center rounded-2 mb-2" t-att-class="{'bg-light': this.ui.isSmall}">
        <div class="d-flex flex-column align-items-center py-2">
            <div class="bg-primary text-white rounded-2 d-flex mb-2 p-2">
                <i class="oi oi-users fs-4"/>
            </div>
            <div class="fs-3 o-fw-600 mb-1">
                <t t-if="this.showCallPreview">You've been invited to a meeting!</t>
                <t t-else="">You've been invited to a chat!</t>
            </div>
        </div>
        <div class="border rounded-2 p-2 d-flex align-items-center gap-3 w-100 text-start">
            <img class="rounded-circle flex-shrink-0"
                t-att-src="this.channel.create_uid.avatarUrl" alt="Thream Image" width="40" height="40"/>
            <div class="d-flex flex-column overflow-hidden">
                <span class="o-fw-600 text-uppercase text-muted small">Invited by</span>
                <span class="o-fw-600 text-truncate" t-att-title="this.channel.create_uid.name" t-out="this.channel.create_uid.name"/>
                <span class="text-truncate" t-if="this.store.companyName" t-att-title="this.store.companyName" t-out="this.store.companyName"/>
            </div>
        </div>
    </div>
</t>

<t t-name="mail.WelcomePage.meetingDetails">
    <div t-if="this.channel.description or this.channel.member_count > 0" class="w-100 text-start rounded-2 p-2 mb-lg-2 bg-secondary-subtle ">
        <div class="d-flex justify-content-between align-items-end gap-2" t-att-class="{'mb-1': this.channel.description}">
            <div class="d-flex align-items-center gap-2 fs-5 overflow-hidden">
                <i class="text-muted" t-att-class="this.showCallPreview ? 'fa fa-calendar' : 'fa fa-comments'"/>
                <span class="fw-medium text-truncate" t-att-title="this.channel.displayName" t-out="this.channel.displayName"/>
            </div>
            <AvatarStack personas="this.channel.channel_member_ids.map(m => m.persona).filter(p => p)" total="this.channel.member_count" />
        </div>
        <div t-if="this.channel.description" class="o-mail-WelcomePage-description text-muted overflow-hidden" t-out="this.channel.description"/>
    </div>
</t>

<t t-name="mail.WelcomePage.joinSection">
    <div class="mb-2" t-if="this.store.self_guest and !this.store.self_user">
        <label class="d-flex justify-content-between align-items-center mb-1">
            <span class="o-fw-600">Enter your name</span>
            <small class="text-muted" t-att-class="{'text-danger': this.state.userName.length > 60}">
                <t t-out="this.state.userName.length"/>/60
            </small>
        </label>
        <input class="form-control form-control-lg rounded" type="text" name="guest_name" placeholder="E.g: John Doe" t-custom-model="this.state.userName" t-on-keydown="this.onKeydownInput"/>
    </div>
    <div t-elif="this.store.self_user" class="border rounded-2 p-2 mb-2 d-flex align-items-center gap-3">
        <img t-attf-src="/web/image/res.users/{{this.store.self_user.id}}/avatar_128/64x64" class="rounded-circle flex-shrink-0" alt="User avatar" width="40" height="40"/>
        <div class="d-flex flex-column overflow-hidden">
            <span class="small text-uppercase text-muted o-fw-600">Joining as</span>
            <span class="o-fw-600 text-truncate" t-att-title="this.store.self_user?.name || this.state.userName.trim() || 'Guest'" t-out="this.store.self_user?.name || this.state.userName.trim() || 'Guest'"/>
        </div>
    </div>
    <button class="btn btn-primary btn-lg w-100 mb-2" title="Join Channel" t-att-disabled="!this.canJoin" t-on-click="this.joinChannel">
        <t t-if="this.showCallPreview">Join call</t>
        <t t-else="">Join conversation</t>
        <i class="oi oi-arrow-right ms-2"/>
    </button>
</t>

<t t-name="mail.WelcomePage.details">
    <div class="d-flex flex-column gap-2">
        <t t-call="mail.WelcomePage.inviteHeader"/>
        <t t-call="mail.WelcomePage.meetingDetails"/>
        <t t-call="mail.WelcomePage.joinSection"/>
    </div>
</t>

<t t-name="mail.WelcomePage.preview">
    <div t-if="this.showCallPreview" class="w-100">
        <div class="px-0 px-md-3 py-2 py-md-3">
            <CallPreview activateCamera="this.state.activateCamera" activateMicrophone="this.state.activateMicrophone" onSettingsChanged="(settings) => this.onCallSettingsChanged(settings)" hasSettingsAtBottom="true"/>
        </div>
    </div>
</t>

<t t-name="mail.WelcomePage">
    <div class="o-mail-WelcomePage container-xl d-flex align-items-center py-3" style="min-height: 100dvh;">
        <t t-if="this.showCallPreview and !this.ui.isSmall">
            <div class="row align-items-center w-100">
                <div class="col-12 col-lg-8">
                    <t t-call="mail.WelcomePage.preview"/>
                </div>
                <div class="col-12 col-lg-4">
                    <section class="card shadow-sm border-0 rounded-2 w-100 overflow-hidden">
                        <div class="card-body p-2">
                            <t t-call="mail.WelcomePage.details"/>
                        </div>
                    </section>
                </div>
            </div>
        </t>
        <t t-elif="this.ui.isSmall">
            <div class="w-100 px-1 d-flex flex-column gap-2">
                <t t-call="mail.WelcomePage.inviteHeader"/>
                <t t-call="mail.WelcomePage.joinSection"/>
                <t t-call="mail.WelcomePage.meetingDetails"/>
                <t t-call="mail.WelcomePage.preview"/>
            </div>
        </t>
        <t t-else="">
            <div class="row justify-content-center w-100">
                <div class="col-12 col-md-8 col-xl-5">
                    <section class="card shadow-sm border-0 rounded-2 overflow-hidden">
                        <div class="card-body p-2">
                            <t t-call="mail.WelcomePage.details"/>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </div>
</t>

</templates>
