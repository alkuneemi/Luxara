<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='other_info']//group[@name='sale_info_group']" position="after">
                    <group string="Spanish Electronic Invoicing"
                           name="l10n_es_spanish_electronic_invoicing"
                           invisible="country_code != 'ES'">
                        <field name="original_invoice_credited"
                               invisible="move_type not in ['out_refund', 'in_refund'] or reversed_entry_id"
                               required="country_code =='ES' and (move_type in ['out_refund', 'in_refund'] or not reversed_entry_id)"/>
                        <field name="l10n_es_invoicing_period_start_date"/>
                        <field name="l10n_es_invoicing_period_end_date"/>
                        <field name="l10n_es_payment_means"/>
                        <field name="l10n_es_edi_facturae_reason_code" string="Reason"
                               invisible="move_type not in ['out_refund', 'in_refund']"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
