<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">PayPal Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="before">
                <div class="text-muted mb-2" invisible="not paypal_client_id and not paypal_client_secret">
                    This provider is linked with your PayPal account.
                </div>
            </group>
            <sheet position="before">
                <header invisible="code != 'paypal'">
                    <button
                        string="Connect/Create a PayPal account"
                        type="object"
                        name="action_start_onboarding"
                        class="btn-primary"
                        invisible="paypal_client_id"
                    />
                    <button
                        name="action_reset_credentials"
                        string="Disconnect"
                        confirm="Are you sure you want to disconnect?"
                        type="object"
                        class="btn-secondary"
                        invisible="not paypal_client_id"
                    />
                </header>
            </sheet>
            <group name="provider_credentials" position='inside'>
                <group invisible="code != 'paypal'" groups="base.group_no_one">
                    <field
                        name="paypal_email_account"
                    />
                    <field
                        name="paypal_client_id"
                        string="Client ID"
                    />
                    <field
                        name="paypal_client_secret"
                        string="Client Secret"
                        password="True"
                    />
                    <label for="paypal_webhook_id" string="Webhook ID"/>
                    <div class="o_row" col="2">
                        <field name="paypal_webhook_id"/>
                        <button
                            string="Generate your webhook"
                            type="object"
                            name="action_paypal_create_webhook"
                            class="btn-primary"
                            invisible="paypal_webhook_id"
                        />
                    </div>
                    <widget
                        name="documentation_link"
                        path="/applications/finance/payment_providers/paypal.html"
                        label="How to configure your paypal account?"
                        colspan="2"
                    />
                </group>
            </group>
            <group name="provider_credentials" position="after">
                <div
                    invisible="code != 'paypal' or paypal_client_id"
                >
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="code != 'paypal' or not paypal_onboarding_warnings"
                    groups="base.group_no_one"
                >
                    <field name="paypal_onboarding_warnings"/>
                </div>
            </group>
        </field>
    </record>

</odoo>
