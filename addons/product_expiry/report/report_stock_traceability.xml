<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_stock_body_print" inherit_id="stock.report_stock_body_print">
        <xpath expr="//table" position="before">
            <t t-set="has_expiration_date" t-value="any(line['columns'][4] for line in lines)"/>
        </xpath>
        <xpath expr="//thead/tr/th[4]" position="after">
            <th t-if="has_expiration_date" class="o_report_line_header">Expiration Date</th>
        </xpath>
        <xpath expr="//tbody//t[@t-foreach=&quot;a['columns']&quot;]/td" position="attributes">
            <attribute name="t-if">has_expiration_date or column != 5</attribute>
        </xpath>
    </template>

</odoo>
