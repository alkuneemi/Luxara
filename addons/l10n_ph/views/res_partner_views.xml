<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n_ph_bir</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='vat_div']" position="after">
                <field name="l10n_ph_branch_code" invisible="'PH' not in fiscal_country_codes"/>
                <field name="l10n_ph_first_names" invisible="'PH' not in fiscal_country_codes"/>
                <field name="l10n_ph_middle_name" invisible="'PH' not in fiscal_country_codes"/>
                <field name="l10n_ph_last_name" invisible="'PH' not in fiscal_country_codes"/>
            </xpath>
        </field>
    </record>
</odoo>
