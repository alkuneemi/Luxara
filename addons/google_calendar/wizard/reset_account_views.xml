<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="google_calendar_reset_account_view_form" model="ir.ui.view">
        <field name="name">google.calendar.account.reset.form</field>
        <field name="model">google.calendar.account.reset</field>
        <field name="arch" type="xml">
            <form>
                <p>What should happen to previously synced events?</p>
                <group>
                    <field name="delete_policy" widget="radio" nolabel="1"/>
                </group>
                <p>What should happen to your secondary calendars?</p>
                <group>
                    <field name="calendar_delete_policy" widget="radio" nolabel="1"/>
                </group>

                <footer>
                    <button name="reset_account" string="Continue" type="object" class="btn-primary" data-hotkey="q" invisible="calendar_delete_policy != 'delete_odoo'"
                            confirm="This will delete all your secondary calendars and their events from Odoo.&#10;Are you sure you want to proceed?"
                            confirm-title="Warning" confirm-label="Delete calendars and events"/>
                    <button name="reset_account" string="Continue" type="object" class="btn-primary" data-hotkey="q" invisible="delete_policy != 'delete_odoo' or calendar_delete_policy == 'delete_odoo'"
                            confirm="This will delete all your synchronized events from Odoo.&#10;Are you sure you want to proceed?"
                            confirm-title="Warning" confirm-label="Delete events"/>
                    <button name="reset_account" string="Continue" type="object" class="btn-primary" data-hotkey="q" invisible="calendar_delete_policy == 'delete_odoo' or delete_policy == 'delete_odoo'"/>
                    <button class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="google_calendar_reset_account_action" model="ir.actions.act_window">
        <field name="name">Disconnect Google Calendar</field>
        <field name="res_model">google.calendar.account.reset</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
