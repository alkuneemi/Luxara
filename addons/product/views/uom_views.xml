<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_uom_list_view" model="ir.ui.view">
        <field name="name">product.uom.list</field>
        <field name="model">product.uom</field>
        <field name="arch" type="xml">
            <list string="Packaging Barcodes" editable="bottom">
                <field name="product_id" column_invisible="context.get('product_ids')"/>
                <field name="product_id" domain="[('id', 'in', context.get('product_ids'))]" options="{'no_create': True}" column_invisible="not context.get('product_ids')"/>
                <field name="barcode"/>
                <field name="uom_id" readonly="context.get('default_uom_id')" domain="[('id', 'in', context.get('uom_ids'))] if context.get('uom_ids') else []" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="product_uom_action_view_list" model="ir.actions.act_window">
        <field name="name">Packaging Barcodes</field>
        <field name="res_model">product.uom</field>
        <field name="view_mode">list</field>
        <field name="domain">
            ([('uom_id', '=', context.get('default_uom_id'))] if context.get('default_uom_id') else [])
            + ([('product_id', 'in', context.get('product_ids'))] if context.get('product_ids') else [])
        </field>
    </record>

    <record id="uom_uom_form_view_inherit" model="ir.ui.view">
        <field name="name">uom.uom.form.inherit</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.product_uom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button
                        class="oe_stat_button"
                        icon="fa-barcode"
                        type="action"
                        context="{'default_uom_id': id}"
                        name="%(product.product_uom_action_view_list)d">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Packaging Barcodes</span>
                        </div>
                    </button>
                </div>

                <div invisible="not context.get('show_variant_name')">
                    Barcodes can be configured on
                    <button string="each variant" name="%(product.product_uom_action_view_list)d" context="{'default_uom_id': id, 'default_product_id': context.get('default_product_id')}" type="action" class="btn btn-link p-0"/>.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
