<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Main Widget -->
    <t t-name="hr_attendance.OvertimeDetails">
        <div class="o_field_tags d-inline-flex flex-wrap"
             t-ref="overtimeDetails">

            <div class="d-inline-flex text-info"
                style="cursor:pointer;"
                tabindex="0"
                t-on-click="onClickDetails"
                t-on-keydown="onKeyDown">

                <t t-out="formattedTotal"/>

            </div>
        </div>
    </t>

    <!-- Popover -->
    <t t-name="hr_attendance.OvertimeDetailsPopover">
        <div class="overtime-popover popover">
            <div class="popover-header">
                <div class="d-flex align-items-center w-100">
                    <div class="h5 mt-1 me-auto">
                        Overtime Details
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-ghost-secondary"
                            t-on-click="props.close">
                        <span class="fa fa-close"/>
                    </button>
                </div>
            </div>
            <div class="popover-body p-0 overflow-auto"
                 style="min-width:750px;max-height:420px;">
                <ListRenderer t-props="rendererProps"/>
            </div>
        </div>
    </t>
</templates>
