<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="portal.Chatter">
    <div
        class="o-mail-Chatter o-portal-Chatter container-fluid px-0"
        t-att-class="{'o-review-Chatter': this.env.displayRating }"
        t-on-scroll="this.onScrollDebounced"
        t-ref="root"
    >
        <div class="row">
            <div
                class="o-mail-Chatter-top col-12"
                t-attf-class="{{ this.env.displayRating ? 'col-lg-4' + (this.props.twoColumns ? ' col-xl-3' : '') : '' }}"
                t-ref="top"
            >
                <Composer
                    t-if="this.state.thread and this.props.composer and !this.props.twoColumns"
                    composer="this.state.thread.composer"
                    mode="'extended'"
                    onPostCallback.bind="this.onPostCallback"
                    dropzoneRef="this.rootRef"
                    t-key="this.props.threadId"
                    type="'message'"
                />
            </div>
            <div
                class="o-mail-Chatter-content col-12"
                t-attf-class="{{ this.env.displayRating ? 'col-lg-8 col-xl-8' + (this.props.twoColumns ? ' offset-xl-1' : '') : '' }}"
            >
                <Composer
                    t-if="this.state.thread and this.props.composer and this.props.twoColumns"
                    composer="this.state.thread.composer"
                    mode="'extended'"
                    onPostCallback.bind="this.onPostCallback"
                    dropzoneRef="this.rootRef"
                    t-key="this.props.threadId"
                    type="'message'"
                />
                <div
                    t-if="this.state.thread"
                    t-att-class="{ 'd-none': this.env.displayRating and this.props.twoColumns and this.state.thread.isLoaded and this.state.thread.isEmpty }"
                >
                    <Thread
                        thread="this.state.thread"
                        t-key="this.state.thread.localId"
                        order="'desc'"
                        scrollRef="this.rootRef"
                        jumpPresent="this.state.jumpThreadPresent"
                    />
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
