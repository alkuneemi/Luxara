<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
	<t t-name="hr.ContractEndDateChangeDialog">
		<Dialog title.translate="End of contract?" size="'sm'">
			<div class="mb-3">
				<p>Why did you change the contract end date?</p>
				<div class="d-flex flex-column gap-2">
					<div class="form-check">
						<input
							type="radio"
							id="reason_correction"
							name="contractEndReason"
							class="form-check-input"
							value="correction"
							t-model="state.reason"
						/>
						<label class="form-check-label" for="reason_correction">
							Correction of contract terms
						</label>
					</div>
					<div class="form-check">
						<input
							type="radio"
							id="reason_end_collab"
							name="contractEndReason"
							class="form-check-input"
							value="end_collaboration"
							t-model="state.reason"
						/>
						<label class="form-check-label" for="reason_end_collab">
							End of Collaboration
						</label>
					</div>
					<div class="form-check">
						<input
							type="radio"
							id="reason_new_contract"
							name="contractEndReason"
							class="form-check-input"
							value="new_contract"
							t-model="state.reason"
						/>
						<label class="form-check-label" for="reason_new_contract">
							Start a new contract
						</label>
					</div>
				</div>

				<div t-if="state.reason === 'new_contract'" class="mt-3">
					<Many2XAutocomplete
						activeActions="{}"
						fieldString.translate="Contract Template"
						getDomain="() => contractTemplateDomain"
						resModel="'hr.version'"
						update="(records) => onTemplateUpdate(records)"
						value="state.template.name"
						placeholder.translate="Select a contract template..."
					/>
				</div>
			</div>
            <t t-set-slot="footer">
                <button t-if="state.reason === 'correction'" type="button" class="btn btn-primary" t-on-click="onCorrectContract">
                    Correct Contract terms
                </button>
                <button t-elif="state.reason === 'end_collaboration'" type="button" class="btn btn-primary" t-on-click="onEndCollaboration">
                    End of Collaboration
                </button>
                <button t-elif="state.reason === 'new_contract'" type="button" class="btn btn-primary" t-on-click="onNewContract">
                    Start New Contract
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onDiscard">
                    Discard
                </button>
            </t>
		</Dialog>
	</t>
</templates>
