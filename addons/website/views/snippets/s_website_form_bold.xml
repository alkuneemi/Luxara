<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_website_form_bold" name="Form Bold">
    <section class="s_website_form_bold pb24 pt24">
        <div class="container">
            <div class="row">
                <div class="col-12 col-lg-12 pb0 order-lg-0" style="order: 0;">
                    <h2 style="text-align: left;"><span class="o_rfs" style="font-size: clamp(8px, 1em + 8.2563vw, 400px);">Contact us.</span></h2>
                </div>
                <div class="col-12 col-lg-4 order-lg-0 pt32" style="order: 1;">
                    <i class="fa fa-fw fa-envelope o_not-animable" role="img"/>
                    &#160;&#160;yourcompany@example.com
                    <br/>
                    <i class="fa fa-fw fa-phone o_not-animable" role="img"/>
                    &#160;&#160; +32(0)499 123 456
                    <br/>
                    <i class="fa fa-fw fa-map-marker o_not-animable" role="img"/>
                    &#160;&#160;Brussels, Belgium
                </div>
                <div class="col-12 col-lg-7 offset-lg-1 pt32 order-lg-0" style="order: 2;">
                    <t t-snippet-call="website.s_website_form"/>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
