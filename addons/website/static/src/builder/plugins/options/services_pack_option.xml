<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ServicesPackOption">
    <BuilderRow label.translate="Services">
        <BuilderButton
            type="'success'"
            action="'addItem'"
            actionParam="'.s_services_pack_item:last-of-type'"
            preview="false">
            Add Item
        </BuilderButton>
    </BuilderRow>
</t>

<t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
    <xpath expr="//t[@id='snippet_specific_options']" position="after">
        <services_pack_option template="website.ServicesPackOption" selector=".s_services_pack"/>
    </xpath>
</t>

</templates>
