<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_invoice_form_inherit_ebupot" model="ir.ui.view">
        <field name="name">account.tax.form.inherit.ebupot</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="l10n_id_ebupot_code" invisible="country_code != 'ID'"/>
                <field name="l10n_id_ebupot_facility" invisible="country_code != 'ID'"/>
            </xpath>
        </field>
    </record>
</odoo>
