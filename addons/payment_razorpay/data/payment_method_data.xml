<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- https://razorpay.com/docs/payments/payment-methods/#supported-payment-methods -->

    <record id="payment_method_card" model="payment.method">
        <field name="name">Card</field>
        <field name="code">card</field>
        <field name="sequence">10</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="payment/static/img/card.png"/>
        <field name="support_tokenization">True</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">partial</field>
        <field name="support_refund">partial</field>
        <field name="provider_id" ref="payment.payment_provider_razorpay"/>
    </record>

    <record id="payment_method_emi_india" model="payment.method">
        <field name="name">EMI</field>
        <field name="code">emi_india</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="payment/static/img/card.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">partial</field>
        <field name="support_refund">partial</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
        <field name="provider_id" ref="payment.payment_provider_razorpay"/>
    </record>

    <record id="payment_method_fpx" model="payment.method">
        <field name="name">FPX</field>
        <field name="code">fpx</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="payment/static/img/fpx.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">partial</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.my')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.MYR')])]"/>
        <field name="provider_id" ref="payment.payment_provider_razorpay"/>
    </record>

    <record id="payment_method_netbanking" model="payment.method">
        <field name="name">Netbanking</field>
        <field name="code">netbanking</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="payment/static/img/bank.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">partial</field>
        <field name="support_refund">partial</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
        <field name="provider_id" ref="payment.payment_provider_razorpay"/>
    </record>

    <record id="payment_method_paylater_india" model="payment.method">
        <field name="name">Pay Later</field>
        <field name="code">paylater_india</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="payment/static/img/pay_later.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">partial</field>
        <field name="support_refund">full_only</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
        <field name="provider_id" ref="payment.payment_provider_razorpay"/>
    </record>

    <record id="payment_method_paynow" model="payment.method">
        <field name="name">PayNow</field>
        <field name="code">paynow</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="payment/static/img/paynow.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">partial</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.sg')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.SGD')])]"/>
        <field name="provider_id" ref="payment.payment_provider_razorpay"/>
    </record>

    <record id="payment_method_upi" model="payment.method">
        <field name="name">UPI</field>
        <field name="code">upi</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="payment/static/img/upi.png"/>
        <field name="support_tokenization">True</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">partial</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
        <field name="provider_id" ref="payment.payment_provider_razorpay"/>
    </record>

    <record id="payment_method_wallets_india" model="payment.method">
        <field name="name">Wallets India</field>
        <field name="code">wallets_india</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="bytes" file="payment/static/img/wallet.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">full_only</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.in')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.INR')])]"/>
        <field name="provider_id" ref="payment.payment_provider_razorpay"/>
    </record>

</odoo>
