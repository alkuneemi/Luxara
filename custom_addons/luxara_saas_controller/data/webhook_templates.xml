<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      <!-- Mail Template: Welcome Email -->
      <record id="mail_template_welcome" model="mail.template">
          <field name="name">Luxara SaaS — بريد الترحيب</field>
          <field name="model_id" ref="base.model_res_partner"/>
          <field name="subject">مرحباً بك في Luxara! منصتك جاهزة 🚀</field>
          <field name="email_from">{{ (object.company_id.email or 'noreply@luxara.app') }}</field>
          <field name="email_to">{{ object.email }}</field>
          <field name="body_html" type="html">
  <div style="font-family: Arial, sans-serif; direction: rtl; text-align: right; max-width: 600px; margin: 0 auto;">
      <h2 style="color: #2c3e50;">أهلاً وسهلاً في Luxara! 🎉</h2>
      <p>عزيزي <strong>{{ object.name }}</strong>،</p>
      <p>يسعدنا إخبارك بأن منصتك الخاصة جاهزة تماماً وتعمل الآن.</p>
      <div style="background: #f8f9fa; border-radius: 8px; padding: 20px; margin: 20px 0;">
          <h3 style="color: #3498db;">بيانات الدخول</h3>
          <p><strong>رابط المنصة:</strong>
              <a href="{{ object.saas_client_ids[:1].full_domain }}">
                  {{ object.saas_client_ids[:1].full_domain }}
              </a>
          </p>
          <p><strong>البريد الإلكتروني:</strong> {{ object.email }}</p>
      </div>
      <p>في حال واجهت أي مشكلة، لا تتردد في التواصل مع فريق الدعم.</p>
      <p>مع تحيات،<br/><strong>فريق Luxara</strong></p>
  </div>
          </field>
          <field name="auto_delete">True</field>
      </record>
  </odoo>
  