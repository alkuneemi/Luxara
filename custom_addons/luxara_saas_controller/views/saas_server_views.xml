<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      <!-- Form View: SaaS Server -->
      <record id="view_saas_server_form" model="ir.ui.view">
          <field name="name">saas.server.form</field>
          <field name="model">saas.server</field>
          <field name="arch" type="xml">
              <form string="إعداد السيرفر">
                  <header>
                      <button name="action_test_connection"
                              string="اختبار الاتصال بـ n8n"
                              type="object"
                              class="oe_highlight"/>
                  </header>
                  <sheet>
                      <div class="oe_title">
                          <h1><field name="name" placeholder="اسم الإعداد"/></h1>
                      </div>
                      <group>
                          <group string="إعدادات n8n">
                              <field name="n8n_webhook_url" widget="url"/>
                              <field name="n8n_secret_key" password="True"/>
                              <field name="callback_base_url"/>
                          </group>
                          <group string="إعدادات GitHub">
                              <field name="github_repo_url" widget="url"/>
                              <field name="github_token" password="True"/>
                              <field name="github_base_branch"/>
                          </group>
                      </group>
                      <group>
                          <group string="إعدادات Railway">
                              <field name="railway_api_token" password="True"/>
                              <field name="railway_project_id"/>
                              <field name="railway_base_domain"/>
                          </group>
                      </group>
                  </sheet>
              </form>
          </field>
      </record>

      <!-- List View: SaaS Server -->
      <record id="view_saas_server_list" model="ir.ui.view">
          <field name="name">saas.server.list</field>
          <field name="model">saas.server</field>
          <field name="arch" type="xml">
              <list string="إعدادات السيرفر">
                  <field name="name"/>
                  <field name="n8n_webhook_url"/>
                  <field name="github_base_branch"/>
                  <field name="railway_base_domain"/>
              </list>
          </field>
      </record>

      <!-- Action: SaaS Server -->
      <record id="action_saas_server" model="ir.actions.act_window">
          <field name="name">إعدادات السيرفر</field>
          <field name="res_model">saas.server</field>
          <field name="view_mode">list,form</field>
      </record>
  </odoo>
  