<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      <!-- Form View: SaaS Package -->
      <record id="view_saas_package_form" model="ir.ui.view">
          <field name="name">saas.package.form</field>
          <field name="model">saas.package</field>
          <field name="arch" type="xml">
              <form string="حزمة الاشتراك">
                  <sheet>
                      <div class="oe_title">
                          <h1><field name="name" placeholder="اسم الحزمة"/></h1>
                      </div>
                      <group>
                          <group string="التسعير">
                              <field name="monthly_price"/>
                              <field name="annual_price"/>
                              <field name="currency_id"/>
                          </group>
                          <group string="الموارد">
                              <field name="max_users"/>
                              <field name="max_storage_gb"/>
                              <field name="railway_service_size"/>
                          </group>
                      </group>
                      <group string="الإعدادات التقنية">
                          <field name="odoo_branch"/>
                          <field name="module_list"
                                 widget="char"
                                 placeholder="account,insurance_broker_suite,sale_management"/>
                      </group>
                      <group string="الوصف">
                          <field name="description" nolabel="1"/>
                      </group>
                      <notebook>
                          <page string="العملاء" name="clients">
                              <field name="client_ids" readonly="1">
                                  <list>
                                      <field name="display_name_computed"/>
                                      <field name="subdomain"/>
                                      <field name="state"/>
                                      <field name="full_domain" widget="url"/>
                                  </list>
                              </field>
                          </page>
                      </notebook>
                  </sheet>
              </form>
          </field>
      </record>

      <!-- Kanban View: SaaS Package -->
      <record id="view_saas_package_kanban" model="ir.ui.view">
          <field name="name">saas.package.kanban</field>
          <field name="model">saas.package</field>
          <field name="arch" type="xml">
              <kanban>
                  <field name="name"/>
                  <field name="monthly_price"/>
                  <field name="client_count"/>
                  <field name="color"/>
                  <templates>
                      <t t-name="card">
                          <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_card">
                              <strong><field name="name"/></strong>
                              <div>
                                  <field name="monthly_price"/>
                                  <field name="currency_id"/>
                                  / شهر
                              </div>
                              <div class="o_kanban_footer">
                                  <span class="badge bg-secondary">
                                      <field name="client_count"/> عميل
                                  </span>
                              </div>
                          </div>
                      </t>
                  </templates>
              </kanban>
          </field>
      </record>

      <!-- Action: SaaS Package -->
      <record id="action_saas_package" model="ir.actions.act_window">
          <field name="name">حزم الاشتراك</field>
          <field name="res_model">saas.package</field>
          <field name="view_mode">kanban,list,form</field>
      </record>
  </odoo>
  