<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══ RFQ ═══════════════════════════════════════════════════ -->
        <record id="seq_insurance_rfq" model="ir.sequence">
            <field name="name">Insurance RFQ</field>
            <field name="code">insurance.rfq</field>
            <field name="prefix">RFQ-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ══ CLAIM ══════════════════════════════════════════════════ -->
        <record id="seq_insurance_claim" model="ir.sequence">
            <field name="name">Insurance Claim</field>
            <field name="code">insurance.claim</field>
            <field name="prefix">CLM-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ══ APPLICATION ════════════════════════════════════════════ -->
        <record id="seq_insurance_application" model="ir.sequence">
            <field name="name">Insurance Application</field>
            <field name="code">insurance.application</field>
            <field name="prefix">APP-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ══ POLICY ══════════════════════════════════════════════════ -->
        <record id="seq_insurance_policy" model="ir.sequence">
            <field name="name">Insurance Policy</field>
            <field name="code">insurance.policy</field>
            <field name="prefix">POL-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ══ COMMISSION ══════════════════════════════════════════════ -->
        <record id="seq_insurance_commission" model="ir.sequence">
            <field name="name">Insurance Commission</field>
            <field name="code">insurance.commission</field>
            <field name="prefix">COM-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ══ OPPORTUNITY ═════════════════════════════════════════════ -->
        <record id="seq_insurance_opportunity" model="ir.sequence">
            <field name="name">Insurance Opportunity</field>
            <field name="code">insurance.opportunity</field>
            <field name="prefix">OPP-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ══ QUOTATION (Universal Quoting Engine) ════════════════════ -->
        <record id="seq_insurance_quotation" model="ir.sequence">
            <field name="name">Insurance Quotation</field>
            <field name="code">insurance.quotation</field>
            <field name="prefix">QT-</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ══ CRON: Policy Expiry Check ══════════════════════════════ -->
        <record id="cron_check_policy_expiry" model="ir.cron">
            <field name="name">Insurance: Check Policy Expiry (Renewal Hunter)</field>
            <field name="model_id" ref="model_insurance_policy"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- ══ CRON: Overdue Commissions ══════════════════════════════ -->
        <record id="cron_check_commission_overdue" model="ir.cron">
            <field name="name">Insurance: Mark Overdue Commissions</field>
            <field name="model_id" ref="model_insurance_commission"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
