<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- ══════════════════════════════════════════════════════════════════════
     COMMISSION RATE CONFIGURATION VIEWS
     Model: insurance.commission.rate
     ══════════════════════════════════════════════════════════════════════ -->

<!-- ── LIST ── -->
<record id="view_commission_rate_list" model="ir.ui.view">
    <field name="name">insurance.commission.rate.list</field>
    <field name="model">insurance.commission.rate</field>
    <field name="arch" type="xml">
        <list string="Commission Rates" editable="top"
              decoration-muted="not active">
            <field name="subtype_id" optional="show"/>
            <field name="type_id"    optional="show"/>
            <field name="provider_id"/>
            <field name="rate_type" widget="badge"/>
            <field name="rate"         string="Rate (%)"   optional="show"/>
            <field name="fixed_amount" string="Fixed (OMR)" optional="hide"/>
            <field name="commission_account_id" optional="hide"/>
            <field name="payable_account_id"    optional="hide"/>
            <field name="effective_date" optional="show"/>
            <field name="expiry_date"    optional="show"/>
            <field name="active"         optional="show"/>
        </list>
    </field>
</record>

<!-- ── FORM ── -->
<record id="view_commission_rate_form" model="ir.ui.view">
    <field name="name">insurance.commission.rate.form</field>
    <field name="model">insurance.commission.rate</field>
    <field name="arch" type="xml">
        <form string="Commission Rate Configuration">
            <sheet>
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                        invisible="active"/>
                <div class="oe_title">
                    <label for="display_name" string="Rate Reference"/>
                    <h1><field name="display_name" readonly="1" nolabel="1"/></h1>
                </div>

                <!-- ★ KEY CARD ★ -->
                <div class="o_ins_form_hero">
                    <div class="o_ins_hero_label">العمولة المتفق عليها — Agreed Commission</div>
                    <group>
                        <group string="Product &amp; Provider">
                            <field name="subtype_id" options="{'no_create': true}"/>
                            <field name="type_id" readonly="1"/>
                            <field name="provider_id" options="{'no_create': true}"/>
                        </group>
                        <group string="Commission Rate / النسبة">
                            <field name="rate_type" widget="radio"/>
                            <field name="rate"
                                   string="Commission Rate (%)"
                                   invisible="rate_type != 'percent'"
                                   widget="percentage"/>
                            <field name="fixed_amount"
                                   string="Fixed Amount (OMR)"
                                   invisible="rate_type != 'fixed'"/>
                            <field name="min_rate"
                                   string="Min Rate (%)"
                                   invisible="rate_type != 'percent'"/>
                            <field name="max_rate"
                                   string="Max Rate (%)"
                                   invisible="rate_type != 'percent'"/>
                        </group>
                    </group>
                </div>

                <notebook>
                    <!-- Accounting Tab -->
                    <page string="Accounting / الحسابات" name="accounting">
                        <group>
                            <group string="Chart of Accounts">
                                <field name="journal_id"
                                       options="{'no_create': true}"/>
                                <field name="commission_account_id"
                                       options="{'no_create': true}"/>
                                <field name="payable_account_id"
                                       options="{'no_create': true}"/>
                            </group>
                            <group string="Validity / الصلاحية">
                                <field name="effective_date"/>
                                <field name="expiry_date"/>
                                <field name="active" widget="toggle_button"/>
                            </group>
                        </group>

                        <!-- Accounting explainer box -->
                        <div class="alert alert-info mt-3" role="alert">
                            <strong>📊 كيف تعمل القيود المحاسبية:</strong><br/>
                            عند تأكيد العمولة يُنشأ قيد تلقائياً:
                            <ul class="mb-0 mt-1">
                                <li><strong>مدين:</strong> حساب المدينين (إجمالي القسط)</li>
                                <li><strong>دائن:</strong> حساب دخل العمولة (حصة البروكر)</li>
                                <li><strong>دائن:</strong> حساب الشركة المزودة (الصافي للشركة)</li>
                            </ul>
                        </div>
                    </page>

                    <!-- Notes Tab -->
                    <page string="Notes" name="notes">
                        <field name="notes" placeholder="ملاحظات إضافية..."/>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<!-- ── SEARCH ── -->
<record id="view_commission_rate_search" model="ir.ui.view">
    <field name="name">insurance.commission.rate.search</field>
    <field name="model">insurance.commission.rate</field>
    <field name="arch" type="xml">
        <search string="Search Commission Rates">
            <field name="subtype_id"/>
            <field name="provider_id"/>
            <filter string="Active"   name="active"   domain="[('active','=',True)]"/>
            <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            <group expand="0" string="Group By">
                <filter string="Provider"        name="grp_provider" context="{'group_by':'provider_id'}"/>
                <filter string="Insurance Type"  name="grp_type"     context="{'group_by':'type_id'}"/>
            </group>
        </search>
    </field>
</record>

<!-- ── ACTION ── -->
<record id="action_commission_rate" model="ir.actions.act_window">
    <field name="name">Commission Rates / نسب العمولات</field>
    <field name="res_model">insurance.commission.rate</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_commission_rate_search"/>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            أنشئ أول معدل عمولة — Create your first commission rate
        </p>
        <p>
            حدّد نسبة العمولة المتفق عليها مع كل شركة تأمين لكل منتج.
            ستُطبَّق تلقائياً عند إنشاء عمولات على الوثائق.
        </p>
    </field>
</record>

</data>
</odoo>
