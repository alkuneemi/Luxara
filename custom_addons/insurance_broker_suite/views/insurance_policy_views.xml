<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="view_insurance_policy_list" model="ir.ui.view">
            <field name="name">insurance.policy.list</field>
            <field name="model">insurance.policy</field>
            <field name="arch" type="xml">
                <list string="Policies"
                    decoration-danger="status in ('expired','cancelled')"
                    decoration-warning="is_expiring_soon and status == 'active'"
                    decoration-success="status == 'active' and not is_expiring_soon">
                    <field name="policy_number"/>
                    <field name="client_id"/>
                    <field name="insurance_type" widget="badge"/>
                    <field name="insurer_id" string="Insurer Company" optional="show"/>
                    <field name="insurer" string="Insurer (Manual)" optional="hide"/>
                    <field name="issue_date"/>
                    <field name="expiry_date"/>
                    <field name="days_to_expiry" string="Days Left" optional="show"/>
                    <field name="net_premium" widget="monetary"/>
                    <field name="commission" widget="monetary" optional="show"/>
                    <field name="status" widget="badge"
                        decoration-success="status == 'active'"
                        decoration-danger="status in ('expired','cancelled')"
                        decoration-warning="status == 'pending'"
                        decoration-info="status == 'renewed'"
                    />
                    <field name="is_expiring_soon" column_invisible="1"/>
                    <field name="claim_count" string="Claims" optional="show"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_insurance_policy_form" model="ir.ui.view">
            <field name="name">insurance.policy.form</field>
            <field name="model">insurance.policy</field>
            <field name="arch" type="xml">
                <form string="Insurance Policy">
                    <header>
                        <button name="action_cancel" string="Cancel Policy" type="object" class="btn-warning"
                            invisible="status not in ('active','pending')"/>
                        <button name="action_renew" string="Renew Policy" type="object" class="btn-primary"
                            invisible="status not in ('active','expired')"/>
                        <field name="status" widget="statusbar" statusbar_visible="pending,active,renewed,expired"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_claims" icon="fa-exclamation-circle">
                                <field name="claim_count" widget="statinfo" string="Claims"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="policy_number" string="Policy Number"/>
                            <h1><field name="policy_number" readonly="1"/></h1>
                        </div>

                        <!-- ★ KEY FIELDS CARD ★ -->
                        <div class="o_ins_form_hero">
                            <div class="o_ins_hero_label">Essential Policy Information</div>
                            <group>
                                <group>
                                    <field name="client_id" options="{'no_create': true}"/>
                                    <field name="insurance_type"/>
                                    <field name="insurer" placeholder="e.g. Oman Insurance Co."/>
                                </group>
                                <group>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="net_premium" widget="monetary"/>
                                    <field name="commission_rate" string="Commission Rate (%)"/>
                                </group>
                            </group>
                        </div>

                        <!-- Secondary fields -->
                        <group>
                            <group string="Additional Details">
                                <field name="sum_assured" widget="monetary"/>
                                <field name="rfq_id" optional="true"/>
                                <field name="crm_lead_id" optional="true" readonly="1"/>
                            </group>
                            <group string="Computed">
                                <field name="commission" widget="monetary" readonly="1"/>
                                <field name="days_to_expiry" readonly="1" invisible="status != 'active'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Coverage Details" name="coverage">
                                <group>
                                    <field name="coverage_details" nolabel="1" colspan="2"
                                        placeholder="Coverage details, terms and conditions..."/>
                                </group>
                                <group string="Vehicle Details" invisible="insurance_type != 'motor'">
                                    <group>
                                        <field name="vehicle_chassis_no"/>
                                        <field name="vehicle_plate_no"/>
                                    </group>
                                    <group>
                                        <field name="vehicle_year"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Claims" name="claims">
                                <field name="claim_ids" mode="list" readonly="1">
                                    <list>
                                        <field name="claim_number"/>
                                        <field name="incident_date"/>
                                        <field name="claim_amount" widget="monetary"/>
                                        <field name="settled_amount" widget="monetary"/>
                                        <field name="status" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Commissions" name="commissions">
                                <field name="commission_ids" mode="list" readonly="1">
                                    <list>
                                        <field name="expected_amount" widget="monetary"/>
                                        <field name="received_amount" widget="monetary"/>
                                        <field name="outstanding_amount" widget="monetary"/>
                                        <field name="due_date"/>
                                        <field name="status" widget="badge"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" placeholder="Internal notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->

        <!-- ACTIONS -->
        <record id="action_insurance_policy" model="ir.actions.act_window">
            <field name="name">All Policies</field>
            <field name="res_model">insurance.policy</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No policies yet!</p>
                <p>Add your first insurance policy or convert a won RFQ into a policy.</p>
            </field>
        </record>

        <record id="action_insurance_policy_expiring" model="ir.actions.act_window">
            <field name="name">Expiring Soon</field>
            <field name="res_model">insurance.policy</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_expiring_soon','=',True),('status','=','active')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No policies expiring soon!</p>
            </field>
        </record>

    </data>
</odoo>
