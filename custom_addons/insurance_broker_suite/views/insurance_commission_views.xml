<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- ══════════════════════════════════════════════════════════════════════
     COMMISSION RECORD VIEWS  —  insurance.commission
     ══════════════════════════════════════════════════════════════════════ -->

<!-- ── LIST ── -->
<record id="view_insurance_commission_list" model="ir.ui.view">
    <field name="name">insurance.commission.list</field>
    <field name="model">insurance.commission</field>
    <field name="arch" type="xml">
        <list string="Commissions — العمولات"
              decoration-danger="status == 'overdue'"
              decoration-success="status in ('received','paid_out')"
              decoration-warning="status == 'partial'"
              decoration-info="status == 'draft'">
            <field name="name"/>
            <field name="policy_id"/>
            <field name="client_id"/>
            <field name="insurer_id"          optional="show"/>
            <field name="invoice_amount"      string="Premium (OMR)"    widget="monetary"/>
            <field name="commission_rate_pct" string="Rate %"           widget="percentage" optional="show"/>
            <field name="commission_amount"   string="Commission (OMR)" widget="monetary"/>
            <field name="insurer_amount"      string="Net to Insurer"   widget="monetary"   optional="show"/>
            <field name="due_date"/>
            <field name="received_date"       optional="show"/>
            <field name="status" widget="badge"
                   decoration-secondary="status == 'draft'"
                   decoration-info="status == 'confirmed'"
                   decoration-warning="status == 'partial'"
                   decoration-success="status in ('received','paid_out')"
                   decoration-danger="status == 'overdue'"/>
            <field name="move_id"             optional="show"/>
            <button name="action_confirm"
                    string="Confirm"
                    type="object" class="btn-primary btn-sm"
                    invisible="status != 'draft'"/>
            <button name="action_mark_received"
                    string="Received"
                    type="object" class="btn-success btn-sm"
                    invisible="status not in ('confirmed','partial','overdue')"/>
        </list>
    </field>
</record>

<!-- ── FORM ── -->
<record id="view_insurance_commission_form" model="ir.ui.view">
    <field name="name">insurance.commission.form</field>
    <field name="model">insurance.commission</field>
    <field name="arch" type="xml">
        <form string="Commission Record — سجل العمولة">

            <!-- ══ ACTION BUTTONS ══ -->
            <header>
                <button name="action_confirm"
                        string="✅ تأكيد وإنشاء القيد المحاسبي"
                        type="object" class="btn-primary"
                        invisible="status != 'draft'"
                        confirm="سيتم تأكيد العمولة وإنشاء قيد محاسبي تلقائياً. هل تريد المتابعة؟"/>
                <button name="action_mark_received"
                        string="✔ تسجيل الاستلام"
                        type="object" class="btn-success"
                        invisible="status not in ('confirmed','partial','overdue')"/>
                <button name="action_mark_paid_out"
                        string="💸 دُفعت للشركة"
                        type="object" class="btn-info"
                        invisible="status != 'received'"/>
                <button name="action_mark_partial"
                        string="⚡ استلام جزئي"
                        type="object" class="btn-warning"
                        invisible="status not in ('confirmed','overdue')"/>
                <button name="action_view_journal_entry"
                        string="📒 عرض القيد المحاسبي"
                        type="object" class="btn-secondary"
                        invisible="not move_id"/>
                <button name="action_reset_draft"
                        string="↩ إعادة للمسودة"
                        type="object"
                        invisible="status != 'overdue'"/>
                <field name="status" widget="statusbar"
                       statusbar_visible="draft,confirmed,received,paid_out"/>
            </header>

            <sheet>
                <div class="oe_title">
                    <label for="name" string="Commission Reference / مرجع العمولة"/>
                    <h1><field name="name" readonly="1"/></h1>
                </div>

                <!--
                ╔══════════════════════════════════════════════════════════════╗
                ║  🟦 دليل المراحل: كيف تسير العمولة                         ║
                ╚══════════════════════════════════════════════════════════════╝
                -->
                <div class="alert alert-primary" role="alert">
                    <strong>📘 دليل مراحل العمولة — Commission Workflow Guide:</strong>
                    <div class="row mt-2 text-center">
                        <div class="col">
                            <div class="badge bg-secondary fs-6 w-100">1️⃣ مسودة</div>
                            <small class="text-muted d-block mt-1">أدخل بيانات الوثيقة والقسط</small>
                        </div>
                        <div class="col-auto align-self-center text-muted">→</div>
                        <div class="col">
                            <div class="badge bg-info text-dark fs-6 w-100">2️⃣ مؤكدة</div>
                            <small class="text-muted d-block mt-1">ينشئ النظام قيداً محاسبياً</small>
                        </div>
                        <div class="col-auto align-self-center text-muted">→</div>
                        <div class="col">
                            <div class="badge bg-success fs-6 w-100">3️⃣ مستلمة</div>
                            <small class="text-muted d-block mt-1">تسجيل استلام العمولة</small>
                        </div>
                        <div class="col-auto align-self-center text-muted">→</div>
                        <div class="col">
                            <div class="badge bg-primary fs-6 w-100">4️⃣ مدفوعة</div>
                            <small class="text-muted d-block mt-1">تحويل صافي الشركة</small>
                        </div>
                    </div>
                </div>

                <!--
                ╔══════════════════════════════════════════════════════════════╗
                ║  🔴 تحذير: لا يمكن التعديل بعد التأكيد                    ║
                ╚══════════════════════════════════════════════════════════════╝
                -->
                <div class="alert alert-danger" role="alert"
                     invisible="status == 'draft'">
                    <strong>🔒 سجل مُقفل — Locked Record:</strong>
                    هذه العمولة مؤكدة ولا يمكن تعديل بياناتها الأساسية.
                    لإجراء تعديل، تواصل مع مدير الحسابات لإلغاء القيد أولاً.
                </div>

                <!-- ★ FINANCIAL SUMMARY CARD ★ -->
                <div class="o_ins_form_hero">
                    <div class="o_ins_hero_label">ملخص العمولة المالي — Commission Financial Summary</div>
                    <div class="row mt-2">
                        <div class="col-4 text-center border-end">
                            <div class="text-muted small fw-bold">إجمالي القسط</div>
                            <div class="fs-3 fw-bold text-primary">
                                <field name="invoice_amount" widget="monetary" nolabel="1"/>
                            </div>
                            <div class="text-muted small">Total Premium</div>
                        </div>
                        <div class="col-4 text-center border-end">
                            <div class="text-muted small fw-bold">عمولة البروكر</div>
                            <div class="fs-3 fw-bold text-success">
                                <field name="commission_amount" widget="monetary" nolabel="1" readonly="1"/>
                            </div>
                            <div class="text-muted small">
                                (<field name="commission_rate_pct" nolabel="1" widget="percentage" readonly="1"/>) Commission
                            </div>
                        </div>
                        <div class="col-4 text-center">
                            <div class="text-muted small fw-bold">صافي للشركة</div>
                            <div class="fs-3 fw-bold text-warning">
                                <field name="insurer_amount" widget="monetary" nolabel="1" readonly="1"/>
                            </div>
                            <div class="text-muted small">Net to Insurer</div>
                        </div>
                    </div>
                </div>

                <!-- ── MAIN FIELDS ── -->
                <group>
                    <group string="📋 الوثيقة والعميل — Policy &amp; Client">
                        <field name="policy_id" options="{'no_create': true}"/>
                        <field name="client_id"       readonly="1"/>
                        <field name="insurer_id"      readonly="1"/>
                        <field name="insurance_type"  readonly="1" widget="badge"/>
                        <field name="subtype_id"      readonly="1"/>
                    </group>
                    <group string="💹 حساب العمولة — Commission Calculation">
                        <!--
                        ╔═══════════════════════════════════════════════════╗
                        ║  🟡 إرشاد: مصدر النسبة                          ║
                        ╚═══════════════════════════════════════════════════╝
                        -->
                        <field name="commission_rate_id"
                               options="{'no_create': true}"
                               help="اختر نسبة العمولة المتفق عليها مع شركة التأمين لهذا المنتج. ستُحسب العمولة تلقائياً."/>
                        <field name="invoice_amount"
                               string="إجمالي القسط (OMR)"
                               help="أدخل إجمالي قسط التأمين كما هو مذكور في الوثيقة. هذا هو المبلغ الكامل المطلوب من العميل."/>
                        <field name="commission_rate_pct"
                               string="نسبة العمولة (%)"
                               widget="percentage"
                               help="تُملأ تلقائياً من جدول النسب. يمكن تعديلها يدوياً إذا لزم الأمر."/>
                        <field name="commission_amount"
                               string="مبلغ العمولة (OMR)"
                               readonly="1"
                               widget="monetary"
                               help="يُحسب تلقائياً = القسط × النسبة%"/>
                        <field name="insurer_amount"
                               string="صافي للشركة (OMR)"
                               readonly="1"
                               widget="monetary"
                               help="يُحسب تلقائياً = القسط - العمولة. هذا ما يُدفع لشركة التأمين."/>
                    </group>
                </group>

                <!--
                ╔══════════════════════════════════════════════════════════════╗
                ║  🟡 إرشاد: حول حقول التواريخ والدفع                       ║
                ╚══════════════════════════════════════════════════════════════╝
                -->
                <div class="alert alert-warning mt-2 mb-2" role="alert">
                    <strong>📅 إرشاد حقول التواريخ والدفع:</strong>
                    <ul class="mb-0 mt-1">
                        <li><strong>تاريخ الاستحقاق:</strong> الموعد المتفق عليه لدفع العمولة من شركة التأمين</li>
                        <li><strong>تاريخ الاستلام:</strong> يُملأ تلقائياً عند الضغط على زر "تسجيل الاستلام"</li>
                        <li><strong>المبلغ المستلم:</strong> في حال الاستلام الجزئي، أدخل المبلغ الفعلي المستلم</li>
                        <li><strong>المرجع:</strong> رقم الشيك / حوالة بنكية / رقم المعاملة</li>
                    </ul>
                </div>

                <group>
                    <group string="📅 التواريخ — Dates">
                        <field name="due_date"/>
                        <field name="received_date"
                               invisible="status not in ('partial','received','paid_out')"/>
                        <field name="paid_out_date"
                               invisible="status != 'paid_out'"/>
                    </group>
                    <group string="💳 الدفع — Payment">
                        <field name="received_amount"
                               string="المبلغ المستلم (OMR)"
                               help="في حال الاستلام الجزئي، أدخل المبلغ الفعلي. اتركه صفراً للاستلام الكامل."/>
                        <field name="outstanding_amount"
                               readonly="1"
                               widget="monetary"
                               help="المبلغ المتبقي = العمولة الكاملة - المبلغ المستلم"/>
                        <field name="payment_method"
                               help="اختر طريقة الدفع: تحويل بنكي / شيك / نقدي / بطاقة"/>
                        <field name="payment_reference"
                               help="رقم المرجع: رقم الشيك / رقم الحوالة البنكية / رقم معاملة بطاقة الدفع"/>
                    </group>
                </group>

                <notebook>
                    <!-- ══ Accounting Tab ══ -->
                    <page string="📒 الحسابات المحاسبية — Accounting" name="accounting">

                        <!--
                        ╔════════════════════════════════════════════════════════╗
                        ║  🟢 إرشاد: ماذا يحدث عند التأكيد؟                  ║
                        ╚════════════════════════════════════════════════════════╝
                        -->
                        <div class="alert alert-success" role="alert">
                            <strong>✅ ماذا يحدث عند ضغط "تأكيد"؟</strong>
                            <ol class="mb-0 mt-1">
                                <li>يُقفل السجل ولا يمكن تعديل بياناته الأساسية</li>
                                <li>يُنشئ النظام <strong>قيداً محاسبياً مؤتمتاً</strong> في يومية العمولات</li>
                                <li>يُضاف رابط "عرض القيد المحاسبي" في شريط الإجراءات</li>
                                <li>يُرسَل إشعار للمراجع المالي (إن كان مُعداً)</li>
                            </ol>
                        </div>

                        <group>
                            <group string="🗂️ الحسابات المستخدمة — Accounts Used">
                                <field name="journal_id"
                                       options="{'no_create': true}"
                                       help="يومية التسجيل — تُملأ تلقائياً من نسبة العمولة"/>
                                <field name="commission_account_id"
                                       options="{'no_create': true}"
                                       help="حساب دخل العمولة (الجانب الدائن) — تُملأ من نسبة العمولة"/>
                                <field name="payable_account_id"
                                       options="{'no_create': true}"
                                       help="حساب مستحقات شركة التأمين (الجانب الدائن) — تُملأ من نسبة العمولة"/>
                                <field name="receivable_account_id"
                                       options="{'no_create': true}"
                                       help="حساب المدينين (الجانب المدين) — إذا تُرك فارغاً يُستخدم حساب المدينين الافتراضي للعميل"/>
                            </group>
                            <group string="📒 القيد المحاسبي — Journal Entry">
                                <field name="move_id"    readonly="1"/>
                                <field name="move_state" readonly="1" widget="badge"
                                       invisible="not move_id"/>
                            </group>
                        </group>

                        <!--
                        ╔════════════════════════════════════════════════════════╗
                        ║  🟦 تفصيل القيد المحاسبي (معاينة)                   ║
                        ╚════════════════════════════════════════════════════════╝
                        -->
                        <div class="alert alert-info mt-3" role="alert"
                             invisible="not invoice_amount">
                            <strong>📊 معاينة القيد المحاسبي — Journal Entry Preview:</strong>
                            <table class="table table-sm table-bordered mt-2 mb-0 bg-white">
                                <thead class="table-primary">
                                    <tr>
                                        <th>الحساب</th>
                                        <th>البيان</th>
                                        <th>مدين (Dr)</th>
                                        <th>دائن (Cr)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><strong>120001</strong> مدينو العملاء</td>
                                        <td>إجمالي القسط من العميل</td>
                                        <td class="text-success fw-bold">
                                            <field name="invoice_amount" nolabel="1" readonly="1"/>
                                        </td>
                                        <td>—</td>
                                    </tr>
                                    <tr>
                                        <td><strong>410001</strong> دخل العمولة</td>
                                        <td>حصة البروكر (<field name="commission_rate_pct" nolabel="1" readonly="1" widget="percentage"/>)</td>
                                        <td>—</td>
                                        <td class="text-danger fw-bold">
                                            <field name="commission_amount" nolabel="1" readonly="1"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>210001</strong> مستحقات الشركة</td>
                                        <td>صافي مستحق لشركة التأمين</td>
                                        <td>—</td>
                                        <td class="text-danger fw-bold">
                                            <field name="insurer_amount" nolabel="1" readonly="1"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <small class="text-muted mt-1 d-block">
                                ⚖️ مجموع المدين = مجموع الدائن — The entry is always balanced.
                            </small>
                        </div>

                        <!--
                        ╔════════════════════════════════════════════════════════╗
                        ║  🟠 إرشاد: بعد تحويل صافي شركة التأمين              ║
                        ╚════════════════════════════════════════════════════════╝
                        -->
                        <div class="alert alert-warning mt-2" role="alert"
                             invisible="status != 'received'">
                            <strong>💸 الخطوة التالية: تحويل صافي شركة التأمين</strong><br/>
                            استلمت العمولة. الآن قم بتحويل
                            <strong><field name="insurer_amount" nolabel="1" readonly="1"/> OMR</strong>
                            لشركة التأمين ثم اضغط <strong>"دُفعت للشركة"</strong>.
                            سيُنشئ النظام قيد التسوية الثاني تلقائياً.
                        </div>
                    </page>

                    <!-- ══ Notes Tab ══ -->
                    <page string="📝 ملاحظات — Notes" name="notes">
                        <!--
                        ╔════════════════════════════════════════════════════════╗
                        ║  🟦 إرشاد: ماذا تكتب هنا                            ║
                        ╚════════════════════════════════════════════════════════╝
                        -->
                        <div class="alert alert-info mb-2" role="alert">
                            <strong>📝 اكتب هنا:</strong> أي تفاصيل إضافية حول هذه العمولة —
                            مثال: تعديل النسبة بسبب حجم الأعمال / استثناء خاص / تواصل مع ممثل الشركة.
                        </div>
                        <field name="notes"
                               placeholder="مثال: تم الاتفاق مع المشرف على رفع النسبة إلى 22% لهذه الوثيقة بسبب حجم الأعمال. مرجع البريد الإلكتروني: INS-2024-0312..."/>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<!-- ── SEARCH ── -->
<record id="view_insurance_commission_search" model="ir.ui.view">
    <field name="name">insurance.commission.search</field>
    <field name="model">insurance.commission</field>
    <field name="arch" type="xml">
        <search string="Search Commissions — البحث في العمولات">
            <field name="name"/>
            <field name="policy_id"/>
            <field name="client_id"/>
            <field name="insurer_id"/>
            <filter string="📄 مسودة"    name="draft"     domain="[('status','=','draft')]"/>
            <filter string="✅ مؤكدة"    name="confirmed" domain="[('status','=','confirmed')]"/>
            <filter string="✔ مستلمة"   name="received"  domain="[('status','=','received')]"/>
            <filter string="⚠️ متأخرة"   name="overdue"   domain="[('status','=','overdue')]"/>
            <filter string="💸 مدفوعة"   name="paid_out"  domain="[('status','=','paid_out')]"/>
            <separator/>
            <filter string="هذا الشهر" name="this_month"
                    domain="[('due_date','&gt;=', (context_today()).strftime('%Y-%m-01'))]"/>
            <filter string="بدون قيد محاسبي" name="no_entry"
                    domain="[('move_id','=',False),('status','!=','draft')]"/>
            <group expand="0" string="Group By">
                <filter string="شركة التأمين"  name="grp_insurer" context="{'group_by':'insurer_id'}"/>
                <filter string="الحالة"         name="grp_status"  context="{'group_by':'status'}"/>
                <filter string="تاريخ الاستحقاق" name="grp_due"   context="{'group_by':'due_date:month'}"/>
            </group>
        </search>
    </field>
</record>

<!-- ── KANBAN ── -->
<record id="view_insurance_commission_kanban" model="ir.ui.view">
    <field name="name">insurance.commission.kanban</field>
    <field name="model">insurance.commission</field>
    <field name="arch" type="xml">
        <kanban default_group_by="status" class="o_kanban_small_column">
            <field name="name"/>
            <field name="client_id"/>
            <field name="insurer_id"/>
            <field name="invoice_amount"/>
            <field name="commission_amount"/>
            <field name="commission_rate_pct"/>
            <field name="insurer_amount"/>
            <field name="due_date"/>
            <field name="status"/>
            <field name="move_id"/>
            <templates>
                <t t-name="card">
                    <div class="fw-bold fs-6">
                        <field name="name"/>
                    </div>
                    <div class="text-muted small">
                        <field name="client_id"/> — <field name="insurer_id"/>
                    </div>
                    <hr class="my-2"/>
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="text-muted" style="font-size:10px">PREMIUM</div>
                            <div class="fw-bold text-primary">
                                <field name="invoice_amount" widget="monetary"/>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-muted" style="font-size:10px">COMMISSION</div>
                            <div class="fw-bold text-success">
                                <field name="commission_amount" widget="monetary"/>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-muted" style="font-size:10px">NET</div>
                            <div class="fw-bold text-warning">
                                <field name="insurer_amount" widget="monetary"/>
                            </div>
                        </div>
                    </div>
                    <div class="mt-2 d-flex justify-content-between align-items-center">
                        <span class="text-muted small">
                            Due: <field name="due_date"/>
                        </span>
                        <field name="status" widget="badge"/>
                    </div>
                    <t t-if="!record.move_id.raw_value">
                        <div class="mt-1">
                            <span class="badge bg-warning text-dark" style="font-size:10px">
                                ⚠️ No Journal Entry
                            </span>
                        </div>
                    </t>
                </t>
            </templates>
        </kanban>
    </field>
</record>

<!-- ── ACTION ── -->
<record id="action_insurance_commission" model="ir.actions.act_window">
    <field name="name">Commissions — العمولات</field>
    <field name="res_model">insurance.commission</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="search_view_id" ref="view_insurance_commission_search"/>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            لا توجد عمولات بعد — No commissions yet
        </p>
        <p>أنشئ وثيقة تأمين وأضف عمولة مرتبطة بها لبدء تتبع الإيرادات وتسجيل القيود المحاسبية.</p>
    </field>
</record>

</data>
</odoo>
