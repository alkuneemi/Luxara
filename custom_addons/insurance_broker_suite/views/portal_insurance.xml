<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- Extend portal home to add insurance count -->
<template id="portal_my_home_insurance" name="Portal: My Insurance Applications" inherit_id="portal.portal_my_home" priority="30">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
        <t t-call="portal.portal_docs_entry">
            <t t-set="title">My Insurance Applications</t>
            <t t-set="url">/my/insurance</t>
            <t t-set="count" t-value="insurance_application_count"/>
            <t t-set="placeholder_count" t-value="'insurance_application_count'"/>
        </t>
    </xpath>
</template>

<!-- My Applications List -->
<template id="portal_my_insurance" name="My Insurance Applications">
    <t t-call="portal.portal_layout">
        <t t-set="breadcrumbs_searchbar" t-value="True"/>
        <t t-call="portal.portal_searchbar">
            <t t-set="title">My Insurance Applications</t>
        </t>
        <t t-if="not applications">
            <div class="alert alert-info text-center py-5">
                <i class="fa fa-shield fa-3x d-block mb-3"/>
                <h4>No applications yet</h4>
                <p class="text-muted mb-4">You haven't submitted any insurance applications yet.</p>
                <a href="/insurance" class="btn btn-primary">Apply for Insurance →</a>
            </div>
        </t>
        <t t-if="applications">
            <div class="row">
                <div class="col-12">
                    <table class="table table-bordered table-hover o_portal_my_doc_table">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Insurance Type</th>
                                <th>Coverage</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="applications" t-as="app">
                                <tr>
                                    <td><span class="fw-semibold" t-esc="app.reference"/></td>
                                    <td><t t-esc="app.category_id.name"/> — <t t-esc="app.type_id.name"/></td>
                                    <td><t t-esc="app.subtype_id.name"/></td>
                                    <td><span t-esc="app.create_date" t-options='{"widget": "date"}'/></td>
                                    <td>
                                        <span t-attf-class="badge #{
                                            app.status == 'submitted' and 'bg-info' or
                                            app.status == 'under_review' and 'bg-warning text-dark' or
                                            app.status == 'info_required' and 'bg-danger' or
                                            app.status == 'approved' and 'bg-success' or
                                            app.status == 'policy_issued' and 'bg-primary' or
                                            app.status == 'rejected' and 'bg-danger' or
                                            'bg-secondary'
                                        }">
                                            <t t-if="app.status == 'draft'">Draft</t>
                                            <t t-if="app.status == 'submitted'">Submitted</t>
                                            <t t-if="app.status == 'under_review'">Under Review</t>
                                            <t t-if="app.status == 'info_required'">Info Required</t>
                                            <t t-if="app.status == 'approved'">Approved / Quoted</t>
                                            <t t-if="app.status == 'policy_issued'">Policy Issued</t>
                                            <t t-if="app.status == 'rejected'">Rejected</t>
                                        </span>
                                    </td>
                                    <td>
                                        <a t-attf-href="/my/insurance/#{app.id}" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="o_portal_pager text-center">
                        <t t-call="portal.pager">
                            <t t-set="url" t-value="'/my/insurance'"/>
                            <t t-set="pager" t-value="pager"/>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </t>
</template>

<!-- Application Detail -->
<template id="portal_my_insurance_detail" name="Insurance Application Detail">
    <t t-call="portal.portal_layout">
        <t t-set="o_portal_fullwidth_alert" groups="base.group_user">
            <t t-call="portal.portal_back_in_edit_mode">
                <t t-set="backend_url" t-value="'/odoo/insurance-applications/%s' % application.id"/>
            </t>
        </t>

        <div class="container py-4">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/my/home">My Account</a></li>
                    <li class="breadcrumb-item"><a href="/my/insurance">Insurance Applications</a></li>
                    <li class="breadcrumb-item active"><t t-esc="application.reference"/></li>
                </ol>
            </nav>

            <div class="row">
                <div class="col-lg-8">
                    <!-- Application Card -->
                    <div class="card mb-4">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h5 class="mb-0 fw-bold">Application <t t-esc="application.reference"/></h5>
                            <span t-attf-class="badge fs-6 #{
                                application.status == 'submitted' and 'bg-info' or
                                application.status == 'under_review' and 'bg-warning text-dark' or
                                application.status == 'info_required' and 'bg-danger' or
                                application.status == 'approved' and 'bg-success' or
                                application.status == 'policy_issued' and 'bg-primary' or
                                application.status == 'rejected' and 'bg-danger' or
                                'bg-secondary'
                            }">
                                <t t-if="application.status == 'draft'">Draft</t>
                                <t t-if="application.status == 'submitted'">Submitted — Under Processing</t>
                                <t t-if="application.status == 'under_review'">Under Review</t>
                                <t t-if="application.status == 'info_required'">Additional Information Required</t>
                                <t t-if="application.status == 'approved'">Approved / Quoted</t>
                                <t t-if="application.status == 'policy_issued'">Policy Issued</t>
                                <t t-if="application.status == 'rejected'">Rejected</t>
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="o_portal_field_label">Category</div>
                                    <div class="fw-semibold" t-esc="application.category_id.name"/>
                                </div>
                                <div class="col-md-6">
                                    <div class="o_portal_field_label">Insurance Type</div>
                                    <div class="fw-semibold" t-esc="application.type_id.name"/>
                                </div>
                                <div class="col-md-6">
                                    <div class="o_portal_field_label">Coverage / Sub-Type</div>
                                    <div class="fw-semibold" t-esc="application.subtype_id.name"/>
                                </div>
                                <div class="col-md-6">
                                    <div class="o_portal_field_label">Submission Date</div>
                                    <div class="fw-semibold" t-esc="application.create_date" t-options='{"widget": "datetime"}'/>
                                </div>
                                <t t-if="application.quoted_premium">
                                    <div class="col-12">
                                        <div class="alert alert-success">
                                            <strong>Quoted Premium:</strong>
                                            <span class="fs-5 ms-2"><t t-esc="application.quoted_premium" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/> OMR</span>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="application.policy_id">
                                    <div class="col-12">
                                        <div class="alert alert-primary">
                                            <strong>Policy Issued:</strong>
                                            <span class="ms-2"><t t-esc="application.policy_id.policy_number"/></span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Information Required Message -->
                    <t t-if="application.status == 'info_required' and application.requirement_message">
                        <div class="card border-danger mb-4">
                            <div class="card-header bg-danger text-white fw-bold">
                                <i class="fa fa-exclamation-triangle me-2"/>Additional Information Required
                            </div>
                            <div class="card-body" t-out="application.requirement_message"/>
                        </div>
                    </t>

                    <!-- Uploaded Documents -->
                    <t t-if="application.document_ids">
                        <div class="card mb-4">
                            <div class="card-header fw-bold"><i class="fa fa-paperclip me-2"/>Uploaded Documents</div>
                            <div class="card-body">
                                <div class="row g-2">
                                    <t t-foreach="application.document_ids" t-as="doc">
                                        <div class="col-md-6">
                                            <a t-attf-href="/web/content/#{doc.id}?download=true" class="d-flex align-items-center p-2 border rounded text-decoration-none text-dark">
                                                <i class="fa fa-file me-2 text-primary"/>
                                                <span t-esc="doc.name"/>
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                    <!-- Quote Offers from Providers -->
                    <t t-if="quotes">
                    <div class="card mb-4 border-0 shadow-sm o_ins_quotes_section">
                        <div class="card-header bg-white fw-bold py-3 d-flex align-items-center justify-content-between">
                            <span><i class="fa fa-tags me-2 text-success"/>Quote Offers Received</span>
                            <span class="badge bg-success rounded-pill"><t t-esc="len(quotes)"/> Quotes</span>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">
                                The following quotes have been submitted by insurance providers in response to your application.
                                Our team will analyse these and recommend the best option.
                            </p>
                            <div class="row g-3">
                                <t t-foreach="quotes" t-as="qt">
                                    <div class="col-md-6 col-lg-4">
                                        <div t-attf-class="o_ins_quote_card card h-100 border-0 #{qt_index == 0 and 'o_ins_quote_top' or ''}">
                                            <div class="card-body p-3">
                                                <!-- Rank badge -->
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span t-attf-class="o_ins_quote_rank rank-#{min(qt_index + 1, 3)}">
                                                        <t t-esc="qt_index + 1"/>
                                                    </span>
                                                    <t t-if="qt.is_recommended">
                                                        <span class="badge bg-success">
                                                            <i class="fa fa-star me-1"/>Recommended
                                                        </span>
                                                    </t>
                                                    <t t-elif="qt.submitted_via_portal">
                                                        <span class="badge bg-light text-muted small">
                                                            <i class="fa fa-globe me-1"/>Online
                                                        </span>
                                                    </t>
                                                </div>
                                                <!-- Insurer Name -->
                                                <div class="fw-bold mb-1 text-truncate" t-esc="qt.insurer"/>
                                                <!-- Premium -->
                                                <div class="o_ins_quote_premium">
                                                    <t t-esc="qt.premium" t-options='{"widget":"float","precision":3}'/> <small class="text-muted fs-6">OMR/yr</small>
                                                </div>
                                                <hr class="my-2"/>
                                                <!-- Key fields -->
                                                <t t-if="qt.deductible">
                                                    <div class="d-flex justify-content-between small">
                                                        <span class="text-muted">Deductible</span>
                                                        <span class="fw-semibold"><t t-esc="qt.deductible" t-options='{"widget":"float","precision":3}'/> OMR</span>
                                                    </div>
                                                </t>
                                                <t t-if="qt.claim_settlement_ratio">
                                                    <div class="d-flex justify-content-between small mt-1">
                                                        <span class="text-muted">CSR</span>
                                                        <span class="fw-semibold text-success"><t t-esc="qt.claim_settlement_ratio"/>%</span>
                                                    </div>
                                                </t>
                                                <t t-if="qt.network">
                                                    <div class="d-flex justify-content-between small mt-1">
                                                        <span class="text-muted">Network</span>
                                                        <span class="fw-semibold text-truncate ms-2"><t t-esc="qt.network"/></span>
                                                    </div>
                                                </t>
                                                <t t-if="qt.validity_date">
                                                    <div class="text-muted small mt-2">
                                                        <i class="fa fa-calendar me-1"/>Valid until
                                                        <t t-esc="qt.validity_date" t-options='{"widget":"date"}'/>
                                                    </div>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <div class="alert alert-info mt-3 mb-0 small">
                                <i class="fa fa-info-circle me-2"/>
                                Our team is reviewing all quotes. You will be notified once a recommendation is ready.
                            </div>
                        </div>
                    </div>
                </t>
                </div><!-- /col-lg-8 -->

                <!-- Timeline Sidebar -->
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header fw-bold"><i class="fa fa-clock-o me-2"/>Application Status</div>
                        <div class="card-body">
                            <div class="o_ins_timeline">
                                <div t-attf-class="o_ins_timeline_item #{application.status in ['submitted','under_review','info_required','approved','policy_issued','rejected'] and 'done' or ''}">
                                    <div class="o_ins_timeline_dot"/>
                                    <div class="o_ins_timeline_content">
                                        <div class="fw-semibold">Submitted</div>
                                        <div class="text-muted small">Application received</div>
                                    </div>
                                </div>
                                <div t-attf-class="o_ins_timeline_item #{application.status in ['under_review','info_required','approved','policy_issued'] and 'done' or application.status == 'rejected' and 'rejected' or ''}">
                                    <div class="o_ins_timeline_dot"/>
                                    <div class="o_ins_timeline_content">
                                        <div class="fw-semibold">Under Review</div>
                                        <div class="text-muted small">Being processed by our team</div>
                                    </div>
                                </div>
                                <div t-attf-class="o_ins_timeline_item #{application.status in ['approved','policy_issued'] and 'done' or application.status == 'info_required' and 'active' or application.status == 'rejected' and 'rejected' or ''}">
                                    <div class="o_ins_timeline_dot"/>
                                    <div class="o_ins_timeline_content">
                                        <div class="fw-semibold">
                                            <t t-if="application.status == 'info_required'">Info Required</t>
                                            <t t-else="">Approved / Quoted</t>
                                        </div>
                                        <div class="text-muted small">Quote issued or info needed</div>
                                    </div>
                                </div>
                                <div t-attf-class="o_ins_timeline_item #{application.status == 'policy_issued' and 'done' or ''}">
                                    <div class="o_ins_timeline_dot"/>
                                    <div class="o_ins_timeline_content">
                                        <div class="fw-semibold">Policy Issued</div>
                                        <div class="text-muted small">Your policy is active</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="/insurance" class="btn btn-outline-primary w-100 mb-2">Apply for Another Insurance</a>
                        <a href="/my/insurance" class="btn btn-outline-secondary w-100">← My Applications</a>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>

</data>
</odoo>
