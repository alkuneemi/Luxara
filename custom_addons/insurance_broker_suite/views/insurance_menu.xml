<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- الجذر الرئيسي -->
        <menuitem id="menu_insurance_root" name="Insurance Broker"
            web_icon="insurance_broker_suite,static/description/icon.png" sequence="90"/>

        <!-- لوحة التحكم -->
        <menuitem id="menu_insurance_dashboard" name="Dashboard / اللوحة الخلفية"
            parent="menu_insurance_root" action="action_insurance_dashboard" sequence="10"/>

        <!-- Ameen Smart Dashboard — Portal URL -->
        <record id="action_ameen_portal_dashboard" model="ir.actions.act_url">
            <field name="name">Ameen Smart Dashboard / داشبورد أمين الذكي</field>
            <field name="url">/ameen/dashboard</field>
            <field name="target">new</field>
        </record>
        <menuitem id="menu_ameen_dashboard"
                  name="Ameen Dashboard / داشبورد أمين"
                  parent="menu_insurance_root"
                  action="action_ameen_portal_dashboard"
                  sequence="11"/>

        <!-- ══ سجلات الطلبات الثلاثة ════════════════════════════════════════ -->
        <menuitem id="menu_insurance_registries" name="Application Registries / السجلات"
            parent="menu_insurance_root" sequence="15"/>
        <menuitem id="menu_insurance_registry_general" name="السجل العام — General Registry"
            parent="menu_insurance_registries"
            action="action_insurance_application_all" sequence="10"/>
        <menuitem id="menu_insurance_applications" name="Online Applications / الأونلاين"
            parent="menu_insurance_registries"
            action="action_insurance_application" sequence="20"/>
        <menuitem id="menu_insurance_registry_sales" name="Sales Registry / سجل المبيعات"
            parent="menu_insurance_registries"
            action="action_insurance_application_sales" sequence="30"/>

        <!-- ── فرص التأمين (insurance.opportunity) ──────────────────────── -->
        <menuitem id="menu_insurance_opportunities" name="الفرص (Opportunities)"
            parent="menu_insurance_root"
            action="action_insurance_opportunity_new" sequence="18"/>

        <!-- ── تسعيرات التأمين — Universal Quotation Engine ──────────────── -->
        <menuitem id="menu_insurance_quotations" name="Quotations / التسعيرات"
            parent="menu_insurance_root" sequence="22"/>
        <menuitem id="menu_insurance_quotations_all" name="All Quotations / جميع التسعيرات"
            parent="menu_insurance_quotations"
            action="action_insurance_quotation" sequence="10"/>
        <menuitem id="menu_insurance_pricing" name="Product Pricing / تسعيرة المنتجات"
            parent="menu_insurance_quotations"
            action="action_insurance_company_pricing" sequence="20"/>

        <!-- ── العملاء ──────────────────────────────────────────────────── -->
        <menuitem id="menu_insurance_clients" name="Clients"
            parent="menu_insurance_root" action="action_insurance_client" sequence="30"/>

        <!-- ── وثائق التأمين ─────────────────────────────────────────────── -->
        <menuitem id="menu_insurance_policies" name="Policies"
            parent="menu_insurance_root" sequence="40"/>
        <menuitem id="menu_insurance_policies_all" name="All Policies"
            parent="menu_insurance_policies" action="action_insurance_policy" sequence="10"/>
        <menuitem id="menu_insurance_policies_expiring" name="Expiring Soon"
            parent="menu_insurance_policies" action="action_insurance_policy_expiring" sequence="20"/>

        <!-- ── RFQ Management ───────────────────────────────────────────── -->
        <menuitem id="menu_insurance_rfq" name="RFQ Management"
            parent="menu_insurance_root" sequence="50"/>
        <menuitem id="menu_insurance_rfq_all" name="All RFQs"
            parent="menu_insurance_rfq" action="action_insurance_rfq" sequence="10"/>
        <menuitem id="menu_insurance_rfq_quotes" name="Insurer Quotes"
            parent="menu_insurance_rfq" action="action_insurance_rfq_quote" sequence="20"/>

        <!-- ── المطالبات ────────────────────────────────────────────────── -->
        <menuitem id="menu_insurance_claims" name="Claims"
            parent="menu_insurance_root" action="action_insurance_claim" sequence="60"/>

        <!-- ── العمولات ─────────────────────────────────────────────────── -->
        <menuitem id="menu_insurance_commissions" name="Commissions"
            parent="menu_insurance_root" action="action_insurance_commission" sequence="70"/>

        <!-- ══ الإعدادات ════════════════════════════════════════════════════ -->
        <menuitem id="menu_insurance_config" name="Configuration"
            parent="menu_insurance_root" sequence="100"/>
        <menuitem id="menu_insurance_config_categories" name="Insurance Categories"
            parent="menu_insurance_config" action="action_insurance_category" sequence="10"/>
        <menuitem id="menu_insurance_config_types" name="Insurance Types"
            parent="menu_insurance_config" action="action_insurance_type" sequence="20"/>
        <menuitem id="menu_insurance_config_subtypes" name="Insurance Sub-Types"
            parent="menu_insurance_config" action="action_insurance_subtype" sequence="30"/>
        <menuitem id="menu_insurance_config_companies" name="Insurance Companies / الشركات"
            parent="menu_insurance_config" action="action_insurance_company_provider" sequence="40"/>
        <menuitem id="menu_insurance_config_pricing" name="Product Pricing / التسعيرة"
            parent="menu_insurance_config" action="action_insurance_company_pricing" sequence="50"/>
        <menuitem id="menu_sahab_ai_settings" name="SAHAB AI Settings"
            parent="menu_insurance_config" action="action_sahab_ai_settings_server" sequence="90"/>
    </data>
</odoo>
