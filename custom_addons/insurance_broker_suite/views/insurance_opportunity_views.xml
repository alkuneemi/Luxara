<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_insurance_opportunity_list_new" model="ir.ui.view">
            <field name="name">insurance.opportunity.list</field>
            <field name="model">insurance.opportunity</field>
            <field name="arch" type="xml">
                <list string="Insurance Opportunities"
                      decoration-success="probability == 100"
                      decoration-muted="active == False">

                    <field name="active" column_invisible="1"/>

                    <field name="name" string="Opportunity"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="contact_name" string="Contact Name" optional="show"/>
                    <field name="email_from" string="Email" optional="show"/>
                    <field name="phone" string="Phone" optional="show"/>
                    <field name="ins_category_id" string="Category" optional="show"/>
                    <field name="ins_type_id" string="Type" optional="show"/>
                    <field name="ins_subtype_id" string="Sub-Type" optional="show"/>
                    <field name="stage_id" string="Stage"/>
                    <field name="current_funnel_step" string="Funnel Step" optional="show"/>
                    <field name="ins_source_id" string="Source" optional="show"/>
                    <field name="probability" string="Probability" widget="progressbar" optional="show"/>
                    <field name="expected_revenue" string="Expected (OMR)" optional="show"/>
                    <field name="user_id" string="Responsible" optional="show"/>
                    <field name="create_date" string="Date" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_insurance_opportunity_form_new" model="ir.ui.view">
            <field name="name">insurance.opportunity.form</field>
            <field name="model">insurance.opportunity</field>
            <field name="arch" type="xml">
                <form string="Insurance Opportunity">
                    <header>
                        <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <!-- Funnel Step Indicator -->
                        <div invisible="current_funnel_step == False"
                             style="background:#eff6ff;border:1px solid #bfdbfe;
                                    border-radius:10px;padding:10px 16px;
                                    margin-bottom:16px;display:flex;align-items:center;gap:10px;">
                            <i class="fa fa-map-signs" style="color:#2563eb;font-size:18px;"/>
                            <span style="font-weight:600;color:#1d4ed8;">خطوة القمع الحالية / Funnel Step:</span>
                            <field name="current_funnel_step" readonly="1"
                                   widget="statusbar"
                                   statusbar_visible="1_categories,2_types,3_subtypes,4_form,5_payment,6_completed"/>
                        </div>

                        <div class="oe_title">
                            <label for="name" string="Opportunity"/>
                            <h1><field name="name" placeholder="e.g. Motor Insurance — Ahmed Al Balushi"/></h1>
                        </div>

                        <group>
                            <group string="بيانات العميل — Customer Info">
                                <field name="partner_id" string="CRM Contact"/>
                                <field name="contact_name" string="Full Name" placeholder="الاسم الكامل"/>
                                <field name="email_from" string="Email" widget="email"/>
                                <field name="phone" string="Phone" widget="phone"/>
                                <field name="ins_source_id" string="Insurance Source"/>
                            </group>
                            <group string="تفاصيل الفرصة — Opportunity Details">
                                <field name="user_id" string="المسؤول"/>
                                <field name="team_id" string="الفريق"/>
                                <field name="probability" string="احتمالية التحويل %"/>
                                <field name="expected_revenue" string="القيمة المتوقعة (OMR)"/>
                                <field name="ai_session_id" string="AI Session ID"
                                       invisible="ins_source_id == False or ins_source_id.code != 'ai_chat'"/>
                            </group>
                        </group>

                        <group string="اختيار التأمين — INSURANCE SELECTION">
                            <group>
                                <field name="ins_category_id" string="فئة التأمين"/>
                                <field name="ins_type_id" string="نوع التأمين"
                                       domain="[('category_id','=',ins_category_id)]"/>
                                <field name="ins_subtype_id" string="النوع الفرعي"
                                       domain="[('type_id','=',ins_type_id)]"/>
                            </group>
                            <group>
                                <field name="last_category_id" string="آخر قسم زيارة" readonly="1"/>
                                <field name="last_type_id" string="آخر نوع زيارة" readonly="1"/>
                                <field name="last_subtype_id" string="آخر نوع فرعي" readonly="1"/>
                            </group>
                        </group>

                        <group string="السجلات المرتبطة — Linked Records"
                               invisible="application_id == False and sales_application_id == False">
                            <field name="application_id" string="Insurance Application" readonly="1"/>
                            <field name="sales_application_id" string="Sales Order" readonly="1"/>
                        </group>

                        <notebook>
                            <!-- TAB: Requirement Details — بيانات الطلب الخاصة بنوع التأمين -->
                            <page string="Requirment Details" name="requirement_details">
                                <!-- هذه التابة تظهر بيانات نموذج الطلب الخاص بالنوع الفرعي المختار -->
                                <div class="alert alert-info" role="alert"
                                     invisible="application_id != False">
                                    <i class="fa fa-info-circle me-2"/>
                                    عند تقديم العميل للطلب، ستظهر هنا بيانات نموذج التأمين الخاص بالنوع الفرعي المختار.
                                </div>

                                <!-- Motor Insurance Details -->
                                <div invisible="application_id == False or application_id.form_type != 'motor'">
                                    <h5 class="text-muted mb-3">
                                        <i class="fa fa-car me-2"/>Motor Insurance Details / بيانات تأمين السيارة
                                    </h5>
                                    <group>
                                        <group string="Personal Information">
                                            <field name="application_id.customer_name" string="Full Name" readonly="1"/>
                                            <field name="application_id.id_number" string="ID / Civil Number" readonly="1"/>
                                            <field name="application_id.customer_phone" string="Phone" readonly="1"/>
                                            <field name="application_id.customer_email" string="Email" readonly="1"/>
                                            <field name="application_id.nationality" string="Nationality" readonly="1"/>
                                        </group>
                                        <group string="Vehicle Information">
                                            <field name="application_id.motor_full_name" string="Name on Licence" readonly="1"/>
                                            <field name="application_id.motor_license_number" string="Driving Licence No." readonly="1"/>
                                            <field name="application_id.motor_plate_number" string="Plate Number" readonly="1"/>
                                            <field name="application_id.motor_plate_character" string="Plate Characters" readonly="1"/>
                                            <field name="application_id.motor_year" string="Vehicle Year" readonly="1"/>
                                            <field name="application_id.motor_make" string="Make" readonly="1"/>
                                            <field name="application_id.motor_model" string="Model" readonly="1"/>
                                            <field name="application_id.motor_chassis_number" string="Chassis No." readonly="1"/>
                                            <field name="application_id.motor_engine_cc" string="Engine CC" readonly="1"/>
                                            <field name="application_id.motor_seating_capacity" string="Seating Capacity" readonly="1"/>
                                            <field name="application_id.motor_is_financed" string="Under Finance?" readonly="1"/>
                                            <field name="application_id.motor_finance_company" string="Finance Company" readonly="1"
                                                invisible="not application_id.motor_is_financed"/>
                                        </group>
                                    </group>
                                </div>

                                <!-- Medical Insurance Details -->
                                <div invisible="application_id == False or application_id.form_type not in ('medical_individual', 'medical_corporate')">
                                    <h5 class="text-muted mb-3">
                                        <i class="fa fa-heartbeat me-2"/>Medical Insurance Details / بيانات التأمين الطبي
                                    </h5>
                                    <group>
                                        <group string="Personal Information">
                                            <field name="application_id.customer_name" string="Full Name" readonly="1"/>
                                            <field name="application_id.id_number" string="ID Number" readonly="1"/>
                                            <field name="application_id.date_of_birth" string="Date of Birth" readonly="1"/>
                                            <field name="application_id.gender" string="Gender" readonly="1"/>
                                        </group>
                                        <group string="Medical Coverage">
                                            <field name="application_id.med_coverage_type" string="Coverage Type" readonly="1"/>
                                            <field name="application_id.med_employee_count" string="Employee Count" readonly="1"/>
                                            <field name="application_id.med_dependents_count" string="Dependents" readonly="1"/>
                                            <field name="application_id.med_network_preference" string="Network Preference" readonly="1"/>
                                            <field name="application_id.med_dental_required" string="Dental?" readonly="1"/>
                                            <field name="application_id.med_optical_required" string="Optical?" readonly="1"/>
                                            <field name="application_id.med_pre_existing" string="Pre-existing Conditions?" readonly="1"/>
                                            <field name="application_id.med_company_name" string="Company Name" readonly="1"/>
                                        </group>
                                    </group>
                                </div>

                                <!-- Property / Fire Insurance Details -->
                                <div invisible="application_id == False or application_id.form_type != 'property_fire'">
                                    <h5 class="text-muted mb-3">
                                        <i class="fa fa-home me-2"/>Property Insurance Details / بيانات تأمين الممتلكات
                                    </h5>
                                    <group>
                                        <group>
                                            <field name="application_id.prop_proposer_name" string="Proposer Name" readonly="1"/>
                                            <field name="application_id.prop_address" string="Property Address" readonly="1"/>
                                            <field name="application_id.prop_cover_type" string="Cover Type" readonly="1"/>
                                            <field name="application_id.prop_usage" string="Property Usage" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="application_id.prop_building_value" string="Building Value (OMR)" readonly="1"/>
                                            <field name="application_id.prop_contents_value" string="Contents Value (OMR)" readonly="1"/>
                                            <field name="application_id.prop_construction_type" string="Construction Type" readonly="1"/>
                                            <field name="application_id.prop_any_previous_loss" string="Previous Loss?" readonly="1"/>
                                        </group>
                                    </group>
                                </div>

                                <!-- Marine Insurance Details -->
                                <div invisible="application_id == False or application_id.form_type != 'marine'">
                                    <h5 class="text-muted mb-3">
                                        <i class="fa fa-ship me-2"/>Marine Insurance Details / بيانات التأمين البحري
                                    </h5>
                                    <group>
                                        <group>
                                            <field name="application_id.marine_voyage_from" string="From" readonly="1"/>
                                            <field name="application_id.marine_voyage_to" string="To" readonly="1"/>
                                            <field name="application_id.marine_departure_date" string="Departure Date" readonly="1"/>
                                            <field name="application_id.marine_arrival_date" string="Arrival Date" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="application_id.marine_cargo_type" string="Cargo Type" readonly="1"/>
                                            <field name="application_id.marine_cargo_value" string="Cargo Value (OMR)" readonly="1"/>
                                            <field name="application_id.marine_vessel_name" string="Vessel Name" readonly="1"/>
                                        </group>
                                    </group>
                                </div>

                                <!-- Life Insurance Details -->
                                <div invisible="application_id == False or application_id.form_type != 'life'">
                                    <h5 class="text-muted mb-3">
                                        <i class="fa fa-heart me-2"/>Life Insurance Details / بيانات التأمين على الحياة
                                    </h5>
                                    <group>
                                        <group>
                                            <field name="application_id.life_sum_assured" string="Sum Assured (OMR)" readonly="1"/>
                                            <field name="application_id.life_policy_term" string="Policy Term (Years)" readonly="1"/>
                                            <field name="application_id.life_payment_frequency" string="Payment Frequency" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="application_id.life_beneficiary_name" string="Beneficiary" readonly="1"/>
                                            <field name="application_id.life_occupation" string="Occupation" readonly="1"/>
                                            <field name="application_id.life_smoker" string="Smoker?" readonly="1"/>
                                            <field name="application_id.life_hazardous_activity" string="Hazardous Activities?" readonly="1"/>
                                        </group>
                                    </group>
                                </div>

                                <!-- Workmen Compensation Details -->
                                <div invisible="application_id == False or application_id.form_type != 'workmen'">
                                    <h5 class="text-muted mb-3">
                                        <i class="fa fa-users me-2"/>Workmen Compensation Details / بيانات تأمين العمال
                                    </h5>
                                    <group>
                                        <group>
                                            <field name="application_id.wc_company_name" string="Company Name" readonly="1"/>
                                            <field name="application_id.wc_employee_count" string="Employee Count" readonly="1"/>
                                            <field name="application_id.wc_total_annual_wages" string="Total Annual Wages (OMR)" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="application_id.wc_business_nature" string="Business Nature" readonly="1"/>
                                            <field name="application_id.wc_any_previous_claims" string="Previous Claims?" readonly="1"/>
                                        </group>
                                    </group>
                                </div>

                                <!-- Generic (fallback) -->
                                <div invisible="application_id == False or application_id.form_type != 'generic'">
                                    <h5 class="text-muted mb-3">
                                        <i class="fa fa-shield me-2"/>Insurance Application Details
                                    </h5>
                                    <group>
                                        <group>
                                            <field name="application_id.customer_name" string="Full Name" readonly="1"/>
                                            <field name="application_id.id_number" string="ID Number" readonly="1"/>
                                            <field name="application_id.customer_phone" string="Phone" readonly="1"/>
                                            <field name="application_id.customer_email" string="Email" readonly="1"/>
                                        </group>
                                    </group>
                                </div>

                                <!-- Documents (always shown when application exists) -->
                                <div invisible="application_id == False" class="mt-3">
                                    <h6 class="text-muted">
                                        <i class="fa fa-paperclip me-2"/>Uploaded Documents / الوثائق المرفقة
                                    </h6>
                                    <field name="application_id.document_ids" readonly="1"
                                        widget="many2many_binary"/>
                                </div>
                            </page>

                            <!-- TAB: Website Journey -->
                            <page string="رحلة العميل / Website Journey" name="journey">
                                <div class="mb-3">
                                    <span class="badge text-bg-info fs-6">
                                        <i class="fa fa-map-signs me-1"/>
                                        <field name="journey_log_count" readonly="1"/> خطوة مسجّلة
                                    </span>
                                </div>
                                <field name="journey_log_ids" readonly="1">
                                    <list string="Journey Log" default_order="id desc"
                                          create="false" delete="false" edit="false">
                                        <field name="create_date" string="الوقت"/>
                                        <field name="action_name" string="الإجراء"/>
                                        <field name="page_url" string="الصفحة"/>
                                    </list>
                                </field>
                            </page>

                            <!-- TAB: Notes -->
                            <page string="ملاحظات / Notes" name="notes">
                                <field name="description" nolabel="1"
                                       placeholder="تفاصيل استفسار العميل..."/>
                            </page>

                            <!-- TAB: AI Chat -->
                            <page string="محادثة AI" name="ai_chat"
                                  invisible="ins_source_id == False or ins_source_id.code != 'ai_chat'">
                                <field name="ai_conversation" nolabel="1"
                                       widget="html"
                                       placeholder="سجل المحادثة مع SAHAB AI..."/>
                            </page>
                        </notebook>
                    </sheet>

                </form>
            </field>
        </record>

        <record id="view_insurance_opportunity_kanban_new" model="ir.ui.view">
            <field name="name">insurance.opportunity.kanban</field>
            <field name="model">insurance.opportunity</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="contact_name"/>
                    <field name="phone"/>
                    <field name="ins_category_id"/>
                    <field name="current_funnel_step"/>
                    <field name="stage_id"/>
                    <field name="probability"/>
                    <field name="user_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="fw-bold mb-1">
                                    <field name="name"/>
                                </div>
                                <div class="text-muted small">
                                    <i class="fa fa-user me-1"/>
                                    <t t-esc="record.contact_name.value or record.partner_id.value"/>
                                </div>
                                <t t-if="record.phone.value">
                                    <div class="text-muted small">
                                        <i class="fa fa-phone me-1"/>
                                        <field name="phone"/>
                                    </div>
                                </t>
                                <t t-if="record.ins_category_id.value">
                                    <div class="mt-1">
                                        <span class="badge bg-primary-subtle text-primary small">
                                            <field name="ins_category_id"/>
                                        </span>
                                    </div>
                                </t>
                                <t t-if="record.current_funnel_step.value">
                                    <div class="mt-1">
                                        <span class="badge bg-info-subtle text-info small">
                                            <i class="fa fa-map-signs me-1"/>
                                            <field name="current_funnel_step"/>
                                        </span>
                                    </div>
                                </t>
                                <div class="mt-2 d-flex justify-content-between align-items-center">
                                    <field name="probability" widget="progressbar"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_insurance_opportunities_new" model="ir.actions.act_window">
            <field name="name">فرص التأمين — Insurance Opportunities</field>
            <field name="res_model">insurance.opportunity</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'default_type': 'opportunity'}</field>
            <field name="view_ids" eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_insurance_opportunity_kanban_new')}),
                (0, 0, {'view_mode': 'list',   'view_id': ref('view_insurance_opportunity_list_new')}),
                (0, 0, {'view_mode': 'form',   'view_id': ref('view_insurance_opportunity_form_new')}),
            ]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">لا توجد فرص تأمين بعد</p>
                <p>تُنشأ الفرص تلقائياً عندما يسجّل عميل الدخول ويزور صفحة التأمين.</p>
            </field>
        </record>

    </data>
</odoo>
