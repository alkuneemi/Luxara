<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_insurance" model="ir.module.category">
            <field name="name">Insurance</field>
            <field name="description">Insurance Broker Suite</field>
            <field name="sequence">90</field>
        </record>

        <record id="group_insurance_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_insurance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_insurance_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_insurance"/>
            <field name="implied_ids" eval="[(4, ref('group_insurance_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
