    {
      "parameters": {
        "method": "POST",
        "url": "https://backboard.railway.app/graphql/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"query\": \"mutation setVars($projectId: String!, $serviceId: String!, $envId: String!, $vars: Json!) { variableCollectionUpsert(input: { projectId: $projectId, environmentId: $envId, serviceId: $serviceId, variables: $vars }) }\",\n  \"variables\": {\n    \"projectId\": \"{{ $vars.RAILWAY_PROJECT_ID }}\",\n    \"serviceId\": \"{{ $json.data.serviceCreate.id }}\",\n    \"envId\": \"{{ $vars.RAILWAY_ENVIRONMENT_ID }}\",\n    \"vars\": {\n      \"DB_HOST\": \"${{ {{ 'db_' + $('Odoo Webhook').item.json.body.subdomain + '.PGHOST' }} }}\",\n      \"DB_PORT\": \"5432\",\n      \"DB_NAME\": \"railway\",\n      \"DB_USER\": \"${{ {{ 'db_' + $('Odoo Webhook').item.json.body.subdomain + '.PGUSER' }} }}\",\n      \"DB_PASSWORD\": \"${{ {{ 'db_' + $('Odoo Webhook').item.json.body.subdomain + '.PGPASSWORD' }} }}\",\n      \"ODOO_MODULES\": \"{{ $('Odoo Webhook').item.json.body.modules }}\",\n      \"CLIENT_SUBDOMAIN\": \"{{ $('Odoo Webhook').item.json.body.subdomain }}\",\n      \"ODOO_BRANCH\": \"{{ $('Odoo Webhook').item.json.body.prod_branch }}\",\n      \"ADMIN_EMAIL\": \"{{ $('Odoo Webhook').item.json.body.email }}\"\n    }\n  }\n}",
        "options": {}
      },
