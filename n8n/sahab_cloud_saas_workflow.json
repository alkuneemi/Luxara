        "body": "={\n  \"query\": \"mutation createDB($projectId: String!, $name: String!) { pluginCreate(input: { projectId: $projectId, name: \\\"postgresql\\\", friendlyName: $name }) { id name } }\",\n  \"variables\": {\n    \"projectId\": \"{{ $vars.RAILWAY_PROJECT_ID }}\",\n    \"name\": \"db_{{ $('Odoo Webhook').item.json.body.subdomain }}\"\n  }\n}",
        "options": {}
