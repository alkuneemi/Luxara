        "contentType": "json",
        "body": "={\n  \"query\": \"mutation createService($projectId: String!, $name: String!) { serviceCreate(input: { projectId: $projectId, name: $name, source: { repo: \\\"https://github.com/{{ $vars.GITHUB_OWNER }}/{{ $vars.GITHUB_REPO }}\\\", branch: \\\"{{ $('Odoo Webhook').item.json.body.prod_branch }}\\\" } }) { id name } }\",\n  \"variables\": {\n    \"projectId\": \"{{ $vars.RAILWAY_PROJECT_ID }}\",\n    \"name\": \"odoo-{{ $('Odoo Webhook').item.json.body.subdomain }}\"\n  }\n}",
        "options": {}
